signment\">\n        <di:waypoint x=\"815\" y=\"415\" />\n        <di:waypoint x=\"815\" y=\"612\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"822\" y=\"520\" width=\"90\" height=\"27\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"MessageFlow_Rectified_di\" bpmnElement=\"MessageFlow_Rectified\">\n        <di:waypoint x=\"1098\" y=\"612\" />\n        <di:waypoint x=\"1098\" y=\"98\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"1104\" y=\"520\" width=\"80\" height=\"27\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"MessageFlow_Report_di\" bpmnElement=\"MessageFlow_Report\">\n        <di:waypoint x=\"1355\" y=\"415\" />\n        <di:waypoint x=\"1355\" y=\"802\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"1362\" y=\"680\" width=\"80\" height=\"27\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNEdge>\n    </bpmndi:BPMNPlane>\n  </bpmndi:BPMNDiagram>\n</bpmn:definitions>\n", "erHierarchy": [{"id": "47f29b3f-c3d9-5ee8-810b-904b2763dc4e", "guid": "47f29b3f-c3d9-5ee8-810b-904b2763dc4e", "shortTitle": "ER_DefectManagement", "name": "Defect management information", "description": "Exchange requirements of the defect management process: one ER per form used in the process. Each ER is linked to a data object in the process map.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [], "constraints": [], "subERs": [{"id": "784ec386-7401-5665-8a09-b19e21022595", "guid": "784ec386-7401-5665-8a09-b19e21022595", "shortTitle": "ER_DefectInspection", "name": "Defect inspection form", "description": "Information the site quality inspector records on site when a defect is identified (paper or mobile form).", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-INS-01", "name": "Inspection number", "dataType": "String / Text", "isMandatory": true, "definition": "Sequential number of the inspection form, e.g. INS-3F-027.", "definitionFigures": [], "synonyms": [], "examples": "INS-3F-027", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-INS-02", "name": "Inspected on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time of the inspection at which the defect was found.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-INS-03", "name": "Inspected by", "dataType": "String / Text", "isMandatory": true, "definition": "Name and e-mail address of the inspector who found the defect.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-INS-04", "name": "Location", "dataType": "String / Text", "isMandatory": true, "definition": "Where the defect is, described by storey, space and grid reference.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066340-93lq22", "text": "위치", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": [{"id": "IU-INS-041", "name": "Storey", "dataType": "String / Text", "isMandatory": true, "definition": "Name of the building storey.", "definitionFigures": [], "synonyms": [], "examples": "3F", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-INS-042", "name": "Space", "dataType": "String / Text", "isMandatory": true, "definition": "Name or number of the space or zone.", "definitionFigures": [], "synonyms": [], "examples": "Corridor C-3F-02", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-INS-043", "name": "Grid reference", "dataType": "String / Text", "isMandatory": false, "definition": "Nearest grid intersection, e.g. C/4.", "definitionFigures": [], "synonyms": [], "examples": "C/4", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}]}, {"id": "IU-INS-05", "name": "Affected element", "dataType": "String / Text", "isMandatory": false, "definition": "Tag or IFC GlobalId of the building element that has the defect, if it is modelled.", "definitionFigures": [], "synonyms": [], "examples": "D-3F-12 (2pQe7N1Xr9hO0sYcJk4b3T)", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-INS-06", "name": "Defect description", "dataType": "String / Text", "isMandatory": true, "definition": "What is wrong, in plain words.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066340-tbay5a", "text": "하자 내용", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-INS-07", "name": "Trade", "dataType": "String / Text", "isMandatory": true, "definition": "Work package or trade that the defect belongs to, e.g. Doors and hardware.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066340-k2bcjt", "text": "Work package", "lang": "en"}, {"id": "syn-1795261066340-3zldy1", "text": "공종", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-INS-08", "name": "Photograph", "dataType": "Image", "isMandatory": true, "definition": "Photograph of the defect taken on site.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066340-sw0rf5", "text": "사진", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-INS-09", "name": "Possible safety hazard", "dataType": "Boolean", "isMandatory": true, "definition": "True if the inspector thinks the defect may endanger people.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-INS-10", "name": "Inspection reference", "dataType": "String / Text", "isMandatory": false, "definition": "Inspection and test plan (ITP) item or checklist under which the defect was found.", "definitionFigures": [], "synonyms": [], "examples": "ITP-DH-04 Fire door installation", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}], "constraints": [], "subERs": [], "fullTitle": "Defect inspection form", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER01", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the defect inspection form", "changedBy": "author-1", "changes": []}], "correspondingEvds": [], "subErs": []}, {"id": "5619d897-1698-5481-854a-ad111a34116f", "guid": "5619d897-1698-5481-854a-ad111a34116f", "shortTitle": "ER_DefectLogEntry", "name": "Defect log entry (BCF topic)", "description": "The defect as a BCF topic in the project issue register, linked to the coordination model by a viewpoint.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-LOG-01", "name": "Defect", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "A construction defect recorded as one BCF topic.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066341-2a6rri", "text": "Snag", "lang": "en-GB"}, {"id": "syn-1795261066341-a151ay", "text": "Punch list item", "lang": "en-US"}, {"id": "syn-1795261066341-kw9fem", "text": "Nonconformity", "lang": "en"}, {"id": "syn-1795261066341-z31mdx", "text": "하자", "lang": "ko"}, {"id": "syn-1795261066341-epwk88", "text": "不具合", "lang": "ja"}, {"id": "syn-1795261066341-l01t6p", "text": "Mangel", "lang": "de"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": [{"id": "IU-LOG-011", "name": "Topic GUID", "dataType": "String / Text", "isMandatory": true, "definition": "Globally unique identifier
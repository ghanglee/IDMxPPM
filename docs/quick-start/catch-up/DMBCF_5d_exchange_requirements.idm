l status", "dataType": "String / Text", "isMandatory": true, "definition": "Closed (or Rejected for defects rejected at triage).", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-CLO-02", "name": "Closed on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time of closure.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-CLO-03", "name": "Closed by", "dataType": "String / Text", "isMandatory": true, "definition": "User who closed the topic.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-CLO-04", "name": "Days to close", "dataType": "Numeric", "isMandatory": true, "definition": "Derived: Closed on minus Created on.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-CLO-05", "name": "Closure sign-off", "dataType": "Document (PDF, DOCX, etc.)", "isMandatory": false, "definition": "Signed closure record, if the contract requires one.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}], "constraints": [], "subERs": [], "fullTitle": "Defect closure record", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER07", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the defect closure record", "changedBy": "author-1", "changes": []}], "correspondingEvds": [], "subErs": []}, "DataObject_StatusReport": {"id": "5361a9a6-ee4e-503f-a81d-eae8f8f15bcb", "guid": "5361a9a6-ee4e-503f-a81d-eae8f8f15bcb", "shortTitle": "ER_DefectStatusReport", "name": "Defect status report", "description": "Daily summary and analysis of all defect topics for the owner's representative.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-RPT-01", "name": "Reporting date", "dataType": "Date / Time", "isMandatory": true, "definition": "Cut-off date of the report.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-RPT-02", "name": "Defect register extract", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "All defect topics at the cut-off date.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-RPT-03", "name": "Defects by status", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Number of defects per status.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-RPT-04", "name": "Defects by priority", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Number of open defects per priority.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-RPT-05", "name": "Defects by trade", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Number of defects per trade.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-RPT-06", "name": "Overdue defects", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Defects that are not Closed or Rejected and whose due date has passed.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066342-ahby2y", "text": "기한 초과 하자", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-RPT-07", "name": "Average days to close", "dataType": "Numeric", "isMandatory": true, "definition": "Mean of days to close over the defects closed so far.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-RPT-08", "name": "Prepared by", "dataType": "String / Text", "isMandatory": true, "definition": "Quality manager who prepared the report.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}], "constraints": [], "subERs": [], "fullTitle": "Defect status report", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER08", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the defect status report", "changedBy": "author-1", "changes": []}], "correspondingEvds": [], "subErs": []}}, "erLibrary": [], "headerData": {"title": "Defect Management Using BCF", "authors": [{"type": "person", "id": "author-1", "givenName": "Ghang", "familyName": "Lee", "middleInitial": "", "affiliation": "Yonsei University", "uri": "glee@yonsei.ac.kr", "prefix": "", "suffix": "", "postnominalDesignation": "", "affiliationOrgIds": [], "isLead": true, "affiliationOrgId": ""}, {"type": "organization", "id": "author-2", "name": "Building Informatics Group (BIG), Yonsei University", "uri": ""}], "organization": "", "version": "1.0", "creationDate": "", "status": "WD", "language": "EN", "region": "KR", "projectStages": ["production"], "useCategories": ["Construction Quality Management", "Issue Management"], "summary": "The general contractor identifies construction defects on site, logs each defect as a BIM Collaboration Format (BCF) topic linked to the building model, triages and assigns it to the responsible trade subcontractor, verifies the rectification and closes the topic. A daily defect status report summarises the BCF topics for the owner's representative.", "revisionHistory": [{"date": "2026-11-20", "description": "Tutorial sample created: process map, eight ERs from the defect management forms, BCF 3.0 mappings, 14 business rules and constraints"}], "contributors": [], "copyright": "Copyright 2026 Building Informatics Group (BIG), Yonsei University. Tutorial sample; fictitious project data; not normative.", "keywords": ["defect management", "BCF", "quality control", "punch list", "issue tracking"], "relatedStandards": [], "externalReferences": [], "objectives": "Aim: replace paper punch lists and spreadsheet defect logs with BCF topics that carry location, photographs, status and responsibility, so that every party works on the same defect record.", "benefits": "One defect record from identification to closure; defects located in the model; measurable response times; fewer disputes about responsibility.", "limitations": "BCF does not define defect-specific fields such as severity or root cause; they are carried as labels or comments by project convention (see the BCF extensions of the project).", "actors": "", "preconditions": "", "postconditions": "", "triggeringEvents": "", "requiredCapabilities": "", "complianceCriteria": "", "actorsList": [{"id": "actor-gc", "name": "General contractor", "external": false, "bpmnShapeName": "Participant_GC", "role": "", "subActors": [{"id": "actor-gc-qi", "name": "Site quality inspector", "role": "", "bpmnShapeName": "Lane_QualityInspector"}, {"id": "actor-gc-bim", "name": "BIM coordinator", "role": "", "bpmnShapeName": "Lane_BIMCoordinator"}, {"id": "actor-gc-qm", "name": "Quality manager", "role": "", "bpmnShapeName": "Lane_QualityManager"}], "bpmnId": "Participant_GC"}, {"id": "actor-sub", "name": "Trade subcontractor", "external": false, "bpmnShapeName": "Participant_Sub", "role": "", "subActors": [], "bpmnId": "Participant_Sub"}, {"id": "actor-own", "name": "Owner's representative", "external": true, "bpmnShapeName": "Participant_Owner", "role": "", "subActors": [], "bpmnId": "Participant_Owner"}], "shortTitle": "DMBCF", "subTitle": "Identification, logging, triage, assignment, resolution, verification and closure of construction defects, with reporting and analysis (tutorial sample)", "localShortTitle": "하자관리", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Tutorial sample created: process map, eight ERs from the defect management forms, BCF 3.0 mappings, 14 business rules and constraints", "changedBy": "author-1", "changes": []}], "publisher": {"name": "Building Informatics Group (BIG), Yonsei University", "location": "Seoul, Republic of Korea"}, "idmCode": "IDM-KR-DMBCF-01", "idmGuid": "afbf4728-82f8-53f9-b57a-e48bc3523bc1", "localDocumentStatus": "", "localCode": "", "idmXsdVersion": "2.0", "idmXsdVersionConfidence": "high", "aimAndScope": "Aim: replace paper punch lists and spreadsheet defect logs with BCF topics that carry location, photographs, status and responsibility, so that every party works on the same defect record.", "uses": [{"verb": "Construction", "noun": "Quality Management"}, {"verb": "Issue", "noun": "Management"}], "useClassification": null, "regions": ["KR"], "projectStagesIso": ["production"], "projectStagesAia": [], "projectStagesRiba": [], "customProjectPhases": [{"id": "custom-phase-1", "classificationName": "Korean construction project phases (건설사업 단계)", "phaseName": "Construction (시공)"}], "benefitKeywords": ["traceability", "response time"], "references": "[basis] ISO 29481-1:2025 Building information models - Information delivery manual - Part 1: Methodology and format\nbuildingSMART International, BIM Collaboration Format (BCF) 3.0, BCF-XML\nISO 19650-2:2018 Organization and digitization of information about buildings and civil engineering works, including BIM - Information management using building information modelling - Part 2: Delivery phase of the assets\nISO 9001:2015 Quality management systems - Requirements, 10.2 Nonconformity and corrective action", "requiredResources": "BCF 3.0 capable issue management tool or common data environment (CDE); IFC 4.3 coordination model; mobile device with camera for site inspection.", "requiredCompetencies": "Site inspection and quality control; use of a BCF viewer; knowledge of the project quality plan.", "constructionEntities": ["Office building", "Healthcare facility"], "additionalDescription": "Sample status = Tutorial sample for xPPM neo-Seoul. Project, companies, people and regulatory references are fictitious or illustrative.", "ucGuid": "df6a2294-7003-564e-858d-042ce4d4aca4", "ucShortTitle": "DMBCF_UC", "ucFullTitle": "Defect Management Using BCF - Use case", "ucIdmCode": "IDM-KR-DMBCF-01-UC", "ucSubTitle": "", "ucDocumentStatus": "WD", "ucVersion": "1.0", "ucLocalCode": "", "ucLocalDocumentStatus": "", "ucChangeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Use case drafted", "changedBy": "author-1", "changes": []}], "summaryFigures": [], "aimAndScopeFigures": [], "benefitsFigures": [], "limitationsFigures": [], "bcmGuid": "224ea1bc-d9fb-5f9e-ba4d-1f1e269f5d26", "bcmShortTitle": "DMBCF_BCM", "bcmFullTitle": "Defect Management Using BCF - Process map", "bcmIdmCode": "IDM-KR-DMBCF-01-BCM", "bcmSubTitle": "", "bcmDocumentStatus": "WD", "bcmVersion": "1.0", "bcmLocalCode": "", "bcmLocalDocumentStatus": "", "bcmChangeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Process map drafted", "changedBy": "author-1", "changes": []}], "pmId": "pm-dmbcf", "pmDiagramName": "Defect management using BCF", "importedActorsList": [{"id": "actor-gc", "name": "General contractor", "
hangeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the defect closure record", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "TopicStatus = Closed."}], "subErs": []}, {"id": "5361a9a6-ee4e-503f-a81d-eae8f8f15bcb", "guid": "5361a9a6-ee4e-503f-a81d-eae8f8f15bcb", "shortTitle": "ER_DefectStatusReport", "name": "Defect status report", "description": "Daily summary and analysis of all defect topics for the owner's representative.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-RPT-01", "name": "Reporting date", "dataType": "Date / Time", "isMandatory": true, "definition": "Cut-off date of the report.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-RPT-02", "name": "Defect register extract", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "All defect topics at the cut-off date.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-ns9ata", "basis": "BCF 3.0", "name": "BCF file (.bcfzip)", "description": "All topics with TopicType = Defect."}], "subInformationUnits": []}, {"id": "IU-RPT-03", "name": "Defects by status", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Number of defects per status.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-rj563j", "basis": "BCF 3.0", "name": "Markup/Topic/@TopicStatus", "description": "Aggregated."}], "subInformationUnits": []}, {"id": "IU-RPT-04", "name": "Defects by priority", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Number of open defects per priority.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-7rx964", "basis": "BCF 3.0", "name": "Markup/Topic/Priority", "description": "Aggregated."}], "subInformationUnits": []}, {"id": "IU-RPT-05", "name": "Defects by trade", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Number of defects per trade.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-hwuxsd", "basis": "BCF 3.0", "name": "Markup/Topic/Labels/Label", "description": "Aggregated by trade label."}], "subInformationUnits": []}, {"id": "IU-RPT-06", "name": "Overdue defects", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Defects that are not Closed or Rejected and whose due date has passed.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066342-ahby2y", "text": "기한 초과 하자", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-6pvwfh", "basis": "BCF 3.0", "name": "Markup/Topic/DueDate", "description": ""}], "subInformationUnits": []}, {"id": "IU-RPT-07", "name": "Average days to close", "dataType": "Numeric", "isMandatory": true, "definition": "Mean of days to close over the defects closed so far.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-RPT-08", "name": "Prepared by", "dataType": "String / Text", "isMandatory": true, "definition": "Quality manager who prepared the report.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}], "constraints": [{"id": "C-DM-14", "businessRuleIds": ["BR-DM-14"], "informationUnitIds": ["IU-RPT-01", "IU-RPT-03", "IU-RPT-04", "IU-RPT-05", "IU-RPT-06", "IU-RPT-07"], "description": "A report exists for every working day (IU-RPT-01) AND IU-RPT-06 lists every defect with IU-LOG-015 NOT IN (Closed, Rejected) AND due date < IU-RPT-01", "expressions": [{"id": "expr-1795261066342-f0y1f8", "xmlId": "C-DM-14-sparql", "language": {"name": "SPARQL", "version": "1.1", "publicationYear": "2013", "uri": ""}, "form": "text", "body": "PREFIX bcf: <https://example.org/bcf#>\nPREFIX rpt: <https://example.org/defect-report#>\nASK {  # true = violation: an overdue defect is missing from the report\n  ?r a rpt:DefectStatusReport ; rpt:reportingDate ?cut .\n  ?t a bcf:Topic ; bcf:topicType \"Defect\" ; bcf:topicStatus ?s ; bcf:dueDate ?due .\n  FILTER ( ?s NOT IN (\"Closed\", \"Rejected\") && ?due < ?cut )\n  FILTER NOT EXISTS { ?r rpt:overdueDefect ?t }\n}", "uri": ""}]}], "subERs": [], "fullTitle": "Defect status report", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER08", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the defect status report", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "Computed from all topics with TopicType = Defect in the BCF file or BCF API."}], "subErs": []}], "fullTitle": "Defect management information", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER00", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format 3.0 (BCF-XML)", "description": "Defects are exchanged as BCF topics (markup.bcf, viewpoint.bcfv, snapshot) with the project vocabularies in extensions.xml."}], "subErs": []}], "dataObjectErMap": {"DataObject_Inspection": "784ec386-7401-5665-8a09-b19e21022595", "DataObject_Topic": "5619d897-1698-5481-854a-ad111a34116f", "DataObject_Triage": "31aad244-33ac-5f23-81f6-113426f23d96", "DataObject_Assignment": "a4642088-e79b-5489-9e28-695bc45c760b", "DataObject_Rectification": "4efac59c-6677-552d-ae4d-30be580cf160", "DataObject_Verification": "1e5828b3-f59e-50b1-83d7-0ed2aab21955", "DataObject_Closure": "1824a928-4180-5eac-a5ae-de918b5bb2ec", "DataObject_StatusReport": "5361a9a6-ee4e-503f-a81d-eae8f8f15bcb"}, "erDataMap": {"DataObject_Inspection": {"id": "784ec386-7401-5665-8a09-b19e21022595", "guid": "784ec386-7401-5665-8a09-b19e21022595", "shortTitle": "ER_DefectInspection", "name": "Defect inspection form", "description": "Information the site quality inspector records on site when a defect is identified (paper or mobile form).", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-INS-01", "name": "Inspection number", "dataType": "String / Text", "isMandatory": true, "definition": "Sequential number of the inspection form, e.g. INS-3F-027.", "definitionFigures": [], "synonyms": [], "examples": "INS-3F-027", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-INS-02", "name": "Inspected on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time of the inspection at which the defect was found.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-y9wcv7", "basis": "BCF 3.0", "name": "Markup/Topic/CreationDate", "description": "Copied to the topic creation date when the topic is logged."}], "subInformationUnits": []}, {"id": "IU-INS-03", "name": "Inspected by", "dataType": "String / Text", "isMandatory": true, "definition": "Name and e-mail address of the inspector who found the defect.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-muqgv6", "basis": "BCF 3.0", "name": "Markup/Topic/CreationAuthor", "description": "E-mail address of a user in extensions.xml."}], "subInformationUnits": []}, {"id": "IU-INS-04", "name": "Location", "dataType": "String / Text", "isMandatory": true, "definition": "Where the defect is, described by storey, space and grid reference.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066340-93lq22", "text": "위치", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": [{"id": "IU-INS-041", "name": "Storey", "dataType": "String / Text", "isMandatory": true, "definition": "Name of the building storey.", "definitionFigures": [], "synonyms": [], "examples": "3F", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-vc3un6", "basis": "IFC 4x3 ADD2", "name": "IfcBuildingStorey.Name", "description": ""}, {"id": "CEE-1795261066340-nv133r", "basis": "BCF 3.0", "name": "Markup/Header/Files/File/@IfcSpatialStructureElement", "description": "GlobalId of the storey."}], "subInformationUnits": []}, {"id": "IU-INS-042", "name": "Space", "dataType": "String / Text", "isMandatory": true, "definition": "Name or number of the space or zone.", "definitionFigures": [], "synonyms": [], "examples": "Corridor C-3F-02", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-ziyujp", "basis": "IFC 4x3 ADD2", "name": "IfcSpace.Name", "description": ""}], "subInformationUnits": []}, {"id": "IU-INS-043", "name": "Grid reference", "dataType": "String / Text", "isMandatory": false, "definition": "Nearest grid intersection, e.g. C/4.", "definitionFigures": [], "synonyms": [], "examples": "C/4", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-9nimqo", "basis": "IFC 4x3 ADD2", "name": "IfcGridAxis.AxisTag", "description": ""}], "subInformationUnits": []}]}, {"id": "IU-INS-05", "name": "Affected element", "dataType": "String / Text", "isMandatory": false, "definition": "Tag or IFC GlobalId of the building element that has the defect, if it is modelled.", "definitionFigures": [], "synonyms": [], "examples": "D-3F-12 (2pQe7N1Xr9hO0sYcJk4b3T)", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-k571ti", "basis": "BCF 3.0", "name": "VisualizationInfo/Components/Selection/Component/@IfcGuid", "description": "Selected component of the first viewpoint."}, {"id": "CEE-1795261066340-grixpp", "basis": "IFC 4x3 ADD2", "name": "IfcRoot.GlobalId", "description": ""}], "subInformationUnits": []}, {"id": "IU-INS-06", "name": "Defect description", "dataType": "String / Text", "isMandatory": true, "definition": "What is wrong, in plain words.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066340-tbay5a", "text": "하자 내용", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-886fsv", "basis": "BCF 3.0", "name": "Markup/Topic/Description", "description": ""}], "subInformationUnits": []}, {"id": "IU-INS-07", "name": "Trade", "dataType": "String / Text", "isMandatory": true, "definition": "Work package or trade that the defect belongs to, e.g. Doors and hardware.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066340-k2bcjt", "text": "Work package", "lang": "en"}, {"id": "syn-1795261066340-3zldy1", "text": "공종", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-5t53xt", "basis": "BCF 3.0", "name": "Markup/Topic/Labels/Label", "description": "Trade label, e.g. Trade: Doors and hardware."}], "subInformationUnits": []}, {"id": "IU-INS-08", "name": "Photograph", "dataType": "Image", "isMandatory": true, "definition": "Photograph of the defect taken on site.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066340-sw0rf5", "text": "사진", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-zdb5ch", "basis": "BCF 3.0", "name": "Markup/Topic/Viewpoints/ViewPoint/Snapshot", "description": "PNG or JPEG snapshot of the first viewpoint."}], "subInformationUnits": []}, {"id": "IU-INS-09", "name": "Possible safety hazard", "dataType": "Boolean", "isMandatory": true, "definition": "True if the inspector thinks the defect may endanger people.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-7u2e5d", "basis": "BCF 3.0", "name": "Markup/Topic/Labels/Label", "description": "Label 'Safety' when true."}], "subInformationUnits": []}, {"id": "IU-INS-10", "name": "Inspection reference", "dataType": "String / Text", "isMandatory": false, "definition": "Inspection and test plan (ITP) item or checklist under which the defect was found.", "definitionFigures": [], "synonyms": [], "examples": "ITP-DH-04 Fire door installation", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-nyc3xq", "basis": "BCF 3.0", "name": "Markup/Topic/ReferenceLinks/ReferenceLink", "description": ""}], "subInformationUnits": []}], "constraints": [{"id": "C-DM-02", "businessRuleIds": ["BR-DM-02"], "informationUnitIds": ["IU-INS-041", "IU-INS-042", "IU-INS-05"], "description": "IU-INS-041 is not empty AND IU-INS-042 is not empty", "expressions": []}], "subERs": [], "fullTitle": "Defect inspection form", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER01", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the defect inspection form", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "The inspection finding becomes a BCF topic in the logging step."}], "subErs": []}, "DataObject_Topic": {"id": "5619d897-1698-5481-854a-ad111a34116f", "guid": "5619d897-1698-5481-854a-ad111a34116f", "shortTitle": "ER_DefectLogEntry", "name": "Defect log entry (BCF topic)", "description": "The defect as a BCF topic in the project issue register, linked to the coordination model by a viewpoint.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-LOG-01", "name": "Defect", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "A construction defect recorded as one BCF topic.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066341-2a6rri", "text": "Snag", "lang": "en-GB"}, {"id": "syn-1795261066341-a151ay", "text": "Punch list item", "lang": "en-US"}, {"id": "syn-1795261066341-kw9fem", "text": "Nonconformity", "lang": "en"}, {"id": "syn-1795261066341-z31mdx", "text": "하자", "lang": "ko"}, {"id": "syn-1795261066341-epwk88", "text": "不具合", "lang": "ja"}, {"id": "syn-1795261066341-l01t6p", "text": "Mangel", "lang": "de"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-hy7j1f", "basis": "BCF 3.0", "name": "Markup/Topic", "description": "TopicType = Defect"}], "subInformationUnits": [{"id": "IU-LOG-011", "name": "Topic GUID", "dataType": "String / Text", "isMandatory": true, "definition": "Globally unique identifier of the topic.", "definitionFigures": [], "synonyms": [], "examples": "3e1f6b52-0c4a-4d8e-9b71-5a2f8c0d1e01", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-ojowu8", "basis": "BCF 3.0", "name": "Markup/Topic/@Guid", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-012", "name": "Defect number", "dataType": "String / Text", "isMandatory": true, "definition": "Project defect number, assigned by the issue server.", "definitionFigures": [], "synonyms": [], "examples": "DEF-0001", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-w8mqe7", "basis": "BCF 3.0", "name": "Markup/Topic/@ServerAssignedId", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-013", "name": "Title", "dataType": "String / Text", "isMandatory": true, "definition": "Short title of the defect.", "definitionFigures": [], "synonyms": [], "examples": "Fire door D-3F-12 does not self-close", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-shpq5t", "basis": "BCF 3.0", "name": "Markup/Topic/Title", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-014", "name": "Topic type", "dataType": "String / Text", "isMandatory": true, "definition": "Type of the topic; always Defect in this IDM.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-7z6ui2", "basis": "BCF 3.0", "name": "Markup/Topic/@TopicType", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-015", "name": "Status", "dataType": "String / Text", "isMandatory": true, "definition": "Current status of the defect in the defect lifecycle.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066341-n3y6g2", "text": "상태", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-4t8mx9", "basis": "BCF 3.0", "name": "Markup/Topic/@TopicStatus", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-016", "name": "Description", "dataType": "String / Text", "isMandatory": true, "definition": "Description of the defect (from the inspection form).", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-fgc41v", "basis": "BCF 3.0", "name": "Markup/Topic/Description", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-017", "name": "Created on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time at which the topic was created.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-p8kch8", "basis": "BCF 3.0", "name": "Markup/Topic/CreationDate", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-018", "name": "Created by", "dataType": "String / Text", "isMandatory": true, "definition": "User who created the topic.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-krlt0a", "basis": "BCF 3.0", "name": "Markup/Topic/CreationAuthor", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-019", "name": "Labels", "dataType": "String / Text", "isMandatory": false, "definition": "Trade, category, severity and safety labels.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-icps7v", "basis": "BCF 3.0", "name": "Markup/Topic/Labels/Label", "description": ""}], "subInformationUnits": []}]}, {"id": "IU-LOG-02", "name": "Model reference", "dataType": "String / Text", "isMandatory": true, "definition": "IFC model file in which the defect is located.", "definitionFigures": [], "synonyms": [], "examples": "RMOB_ARC_3F_v12.ifc", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-qojq8u", "basis": "BCF 3.0", "name": "Markup/Header/Files/File", "description": "Filename, Date and @IfcProject of the coordination model."}], "subInformationUnits": []}, {"id": "IU-LOG-03", "name": "Viewpoint", "dataType": "3D Model", "isMandatory": true, "definition": "Saved view of the model that shows the defect.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-ks2mzq", "basis": "BCF 3.0", "name": "Markup/Topic/Viewpoints/ViewPoint", "description": ""}], "subInformationUnits": [{"id": "IU-LOG-031", "name": "Camera", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Camera position, direction and field of view.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-r1xx45", "basis": "BCF 3.0", "name": "VisualizationInfo/PerspectiveCamera", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-032", "name": "Selected components", "dataType": "String / Text", "isMandatory": true, "definition": "IFC GlobalIds of the affected elements.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-lk4ewe", "basis": "BCF 3.0", "name": "VisualizationInfo/Components/Selection/Component/@IfcGuid", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-033", "name": "Snapshot", "dataType": "Image", "isMandatory": true, "definition": "Image of the viewpoint (photograph or model view).", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-89qquu", "basis": "BCF 3.0", "name": "Markup/Topic/Viewpoints/ViewPoint/Snapshot", "description": ""}], "subInformationUnits": []}]}, {"id": "IU-LOG-04", "name": "Source inspection form", "dataType": "Document (PDF, DOCX, etc.)", "isMandatory": true, "definition": "Reference to the defect inspection form.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-jdhhe1", "basis": "BCF 3.0", "name": "Markup/Topic/DocumentReferences/DocumentReference", "description": "Document stored in the BCF file (documents.xml)."}], "subInformationUnits": []}, {"id": "IU-LOG-05", "name": "Related defects", "dataType": "String / Text", "isMandatory": false, "definition": "Other topics that describe the same or a recurring defect.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-4c2w6r", "basis": "BCF 3.0", "name": "Markup/Topic/RelatedTopics/RelatedTopic/@Guid", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-06", "name": "Construction stage", "dataType": "String / Text", "isMandatory": false, "definition": "Stage of the project in which the defect was found.", "definitionFigures": [], "synonyms": [], "examples": "Fit-out", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-uwkkbp", "basis": "BCF 3.0", "name": "Markup/Topic/Stage", "description": ""}], "subInformationUnits": []}], "constraints": [{"id": "C-DM-01", "businessRuleIds": ["BR-DM-01"], "informationUnitIds": ["IU-LOG-011", "IU-LOG-012"], "description": "IU-LOG-011 is a UUID AND IU-LOG-011 is unique AND IU-LOG-012 is unique within the project", "expressions": [{"id": "expr-1795261066341-n0yqrx", "xmlId": "C-DM-01-py", "language": {"name": "Python", "version": "3", "publicationYear": "", "uri": ""}, "form": "text", "body": "import re\nUUID = re.compile(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')\n\ndef check(topics):\n    \"\"\"topics: list of dicts with 'guid' and 'server_id'. Returns violations.\"\"\"\n    bad = [t['guid'] for t in topics if not UUID.match(t['guid'])]\n    for key in ('guid', 'server_id'):\n        seen = set()\n        for t in topics:\n            if t[key] in seen:\n                bad.append(t[key])\n            seen.add(t[key])\n    return bad  # non-empty = violation", "uri": ""}]}, {"id": "C-DM-03", "businessRuleIds": ["BR-DM-02", "BR-DM-03"], "informationUnitIds": ["IU-LOG-032", "IU-LOG-033"], "description": "The first viewpoint of every defect topic has a snapshot (IU-LOG-033) and at least one selected component (IU-LOG-032) when an element is affected", "expressions": [{"id": "expr-1795261066341-61zqfp", "xmlId": "C-DM-03-sch", "language": {"name": "Schematron", "version": "ISO/IEC 19757-3:2020", "publicationYear": "2020", "uri": "http://purl.oclc.org/dsdl/schematron"}, "form": "xml", "body": "<sch:schema xmlns:sch=\"http://purl.oclc.org/dsdl/schematron\" queryBinding=\"xslt2\">\n              <sch:pattern id=\"bcf-defect-evidence\">\n                <sch:rule context=\"Markup/Topic[@TopicType = 'Defect']\">\n                  <sch:assert test=\"Viewpoints/ViewPoint[1]/Snapshot\">BR-DM-03: defect <sch:value-of select=\"@ServerAssignedId\"/> has no snapshot.</sch:assert>\n                </sch:rule>\n              </sch:pattern>\n            </sch:schema>", "uri": ""}]}, {"id": "C-DM-04", "businessRuleIds": ["BR-DM-04"], "informationUnitIds": ["IU-LOG-014", "IU-LOG-015", "IU-LOG-019"], "description": "IU-LOG-014 = 'Defect' AND IU-LOG-015 IN extensions.xml/TopicStatuses AND every IU-LOG-019 IN extensions.xml/TopicLabels", "expressions": [{"id": "expr-1795261066341-qe680f", "xmlId": "C-DM-04-sch", "language": {"name": "Schematron", "version": "ISO/IEC 19757-3:2020", "publicationYear": "2020", "uri": "http://purl.oclc.org/dsdl/schematron"}, "form": "xml", "body": "<sch:schema xmlns:sch=\"http://purl.oclc.org/dsdl/schematron\" queryBinding=\"xslt2\">\n              <sch:let name=\"ext\" value=\"doc('../extensions.xml')/Extensions\"/>\n              <sch:pattern id=\"bcf-vocabularies\">\n                <sch:rule context=\"Markup/Topic\">\n                  <sch:assert test=\"@TopicType = 'Defect'\">BR-DM-04: topic type shall be Defect.</sch:assert>\n                  <sch:assert test=\"@TopicStatus = $ext/TopicStatuses/TopicStatus\">BR-DM-04: status not in extensions.xml.</sch:assert>\n                  <sch:assert test=\"not(Priority) or Priority = $ext/Priorities/Priority\">BR-DM-04: priority not in extensions.xml.</sch:assert>\n                  <sch:assert test=\"every $l in Labels/Label satisfies $l = $ext/TopicLabels/TopicLabel\">BR-DM-04: label not in extensions.xml.</sch:assert>\n                </sch:rule>\n              </sch:pattern>\n            </sch:schema>", "uri": ""}]}, {"id": "C-DM-05", "businessRuleIds": ["BR-DM-05"], "informationUnitIds": ["IU-LOG-015"], "description": "Each change of IU-LOG-015 is an allowed transition of the defect status lifecycle", "expressions": [{"id": "expr-1795261066341-m85cfl", "xmlId": "C-DM-05-py", "language": {"name": "Python", "version": "3", "publicationYear": "", "uri": ""}, "form": "text", "body": "ALLOWED = {\n    'Open': {'Assigned', 'Rejected'},\n    'Assigned': {'In progress', 'Resolved'},\n    'In progress': {'Resolved'},\n    'Resolved': {'Closed', 'Reopened'},\n    'Reopened': {'Assigned'},\n}\n\ndef check(status_history):\n    \"\"\"status_history: statuses of one topic in time order.\"\"\"\n    return [(a, b) for a, b in zip(status_history, status_history[1:])\n            if b not in ALLOWED.get(a, set())]  # non-empty = violation", "uri": ""}]}], "subERs": [], "fullTitle": "Defect log entry (BCF topic)", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER02", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the defect log entry (bcf topic)", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "One topic per defect: markup.bcf, viewpoint.bcfv and snapshot."}, {"basis": "IFC4.3", "name": "IFC4.3 Reference View", "description": "Coordination model referenced by the BCF header and viewpoints."}], "subErs": []}, "DataObject_Triage": {"id": "31aad244-33ac-5f23-81f6-113426f23d96", "guid": "31aad244-33ac-5f23-81f6-113426f23d96", "shortTitle": "ER_TriageRecord", "name": "Triage record", "description": "Decision of the quality manager on validity, severity, priority and category of a logged defect.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-TRI-01", "name": "Triage decision", "dataType": "String / Text", "isMandatory": true, "definition": "Accept as defect, Reject (not a defect) or Duplicate.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-luztjy", "basis": "BCF 3.0", "name": "Markup/Topic/@TopicStatus", "description": "Accept -> Assigned (after assignment); Reject or Duplicate -> Rejected."}], "subInformationUnits": []}, {"id": "IU-TRI-02", "name": "Severity", "dataType": "String / Text", "isMandatory": true, "definition": "Consequence of the defect: Critical, Major, Minor or Cosmetic.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066341-n3xopn", "text": "심각도", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-4mrvry", "basis": "BCF 3.0", "name": "Markup/Topic/Labels/Label", "description": "Label 'Severity: Major' etc."}], "subInformationUnits": []}, {"id": "IU-TRI-03", "name": "Priority", "dataType": "String / Text", "isMandatory": true, "definition": "Urgency of rectification: P1 - Critical, P2 - High, P3 - Medium or P4 - Low.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066341-qu2kkv", "text": "우선순위", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-n4utzz", "basis": "BCF 3.0", "name": "Markup/Topic/Priority", "description": ""}], "subInformationUnits": []}, {"id": "IU-TRI-04", "name": "Defect category", "dataType": "String / Text", "isMandatory": true, "definition": "Workmanship, Material, Damage, Missing work or Safety.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-o95djq", "basis": "BCF 3.0", "name": "Markup/Topic/Labels/Label", "description": "Label 'Category: Workmanship' etc."}], "subInformationUnits": []}, {"id": "IU-TRI-05", "name": "Safety-critical", "dataType": "Boolean", "isMandatory": true, "definition": "True if the defect endangers people.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-bzyjkb", "basis": "BCF 3.0", "name": "Markup/Topic/Labels/Label", "description": "Label 'Safety' when true."}], "subInformationUnits": []}, {"id": "IU-TRI-06", "name": "Duplicate of", "dataType": "String / Text", "isMandatory": false, "definition": "Defect number of the original defect, if this is a duplicate.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-waxdow", "basis": "BCF 3.0", "name": "Markup/Topic/RelatedTopics/RelatedTopic/@Guid", "description": ""}], "subInformationUnits": []}, {"id": "IU-TRI-07", "name": "Triage comment", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Comment that records the triage.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-c9yr92", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment", "description": ""}], "subInformationUnits": [{"id": "IU-TRI-071", "name": "Triaged on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time of the triage.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-gv42s8", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Date", "description": ""}], "subInformationUnits": []}, {"id": "IU-TRI-072", "name": "Triaged by", "dataType": "String / Text", "isMandatory": true, "definition": "Quality manager who triaged the defect.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-80zmji", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Author", "description": ""}], "subInformationUnits": []}, {"id": "IU-TRI-073", "name": "Rationale", "dataType": "String / Text", "isMandatory": true, "definition": "Reason for the decision and the classification.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-hzfoih", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Comment", "description": ""}], "subInformationUnits": []}]}, {"id": "IU-TRI-08", "name": "Root cause (preliminary)", "dataType": "String / Text", "isMandatory": false, "definition": "Not exchanged in BCF; kept in the quality management system.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}], "constraints": [{"id": "C-DM-06", "businessRuleIds": ["BR-DM-06"], "informationUnitIds": ["IU-LOG-017", "IU-TRI-071"], "description": "working_days(IU-LOG-017, IU-TRI-071) <= 2", "expressions": [{"id": "expr-1795261066341-fuom3w", "xmlId": "C-DM-06-py", "language": {"name": "Python", "version": "3", "publicationYear": "", "uri": ""}, "form": "text", "body": "import numpy as np\n\ndef check(created_on, triaged_on, holidays=()):\n    days = np.busday_count(created_on.date(), triaged_on.date(), holidays=list(holidays))\n    return days > 2  # True = violation", "uri": ""}]}, {"id": "C-DM-08", "businessRuleIds": ["BR-DM-08"], "informationUnitIds": ["IU-TRI-05", "IU-TRI-03"], "description": "IU-TRI-05 = true IMPLIES IU-TRI-03 = 'P1 - Critical'", "expressions": [{"id": "expr-1795261066341-dwdni4", "xmlId": "C-DM-08-shacl", "language": {"name": "SHACL", "version": "", "publicationYear": "2017", "uri": "http://www.w3.org/ns/shacl#"}, "form": "text", "body": "@prefix sh:  <http://www.w3.org/ns/shacl#> .\n@prefix bcf: <https://example.org/bcf#> .\n\nbcf:SafetyCriticalDefectShape a sh:NodeShape ;\n  sh:targetClass bcf:Topic ;\n  sh:or (\n    [ sh:path bcf:label ; sh:not [ sh:hasValue \"Safety\" ] ]\n    [ sh:path bcf:priority ; sh:hasValue \"P1 - Critical\" ]\n  ) ;\n  sh:message \"BR-DM-08: a safety-critical defect shall have priority P1 - Critical\" .", "uri": ""}]}], "subERs": [], "fullTitle": "Triage record", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER03", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the triage record", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "Triage updates the topic and adds a triage comment."}], "subErs": []}, "DataObject_Assignment": {"id": "a4642088-e79b-5489-9e28-695bc45c760b", "guid": "a4642088-e79b-5489-9e28-695bc45c760b", "shortTitle": "ER_AssignmentNotice", "name": "Defect assignment notice", "description": "Instruction from the general contractor to the responsible trade subcontractor to rectify a defect by a due date.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-ASG-01", "name": "Notice number", "dataType": "String / Text", "isMandatory": true, "definition": "Number of the assignment notice.", "definitionFigures": [], "synonyms": [], "examples": "DAN-2026-0141", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-ASG-02", "name": "Responsible party", "dataType": "String / Text", "isMandatory": true, "definition": "Organization responsible for the rectification.", "definitionFigures": [], "synonyms": [], "examples": "Sample Doors & Hardware Ltd.", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-ASG-03", "name": "Assignee", "dataType": "String / Text", "isMandatory": true, "definition": "Person of the responsible party who rectifies the defect.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066341-f2wfun", "text": "담당자", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-blimyz", "basis": "BCF 3.0", "name": "Markup/Topic/AssignedTo", "description": "E-mail address of a user in extensions.xml."}], "subInformationUnits": []}, {"id": "IU-ASG-04", "name": "Due date", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time by which the defect shall be rectified.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066341-sz5pbv", "text": "조치 기한", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-lec1id", "basis": "BCF 3.0", "name": "Markup/Topic/DueDate", "description": ""}], "subInformationUnits": []}, {"id": "IU-ASG-05", "name": "Required action", "dataType": "String / Text", "isMandatory": true, "definition": "What the assignee shall do.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-5cu7u0", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Comment", "description": ""}], "subInformationUnits": []}, {"id": "IU-ASG-06", "name": "Issued on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time of the assignment.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-5uzczb", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Date", "description": ""}], "subInformationUnits": []}, {"id": "IU-ASG-07", "name": "Back-charge applicable", "dataType": "Boolean", "isMandatory": false, "definition": "True if the cost of rectification is charged to the responsible party.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}], "constraints": [{"id": "C-DM-07", "businessRuleIds": ["BR-DM-07"], "informationUnitIds": ["IU-TRI-03", "IU-TRI-071", "IU-ASG-04"], "description": "IU-ASG-04 - IU-TRI-071 <= 1 d (P1), 7 d (P2), 14 d (P3), 30 d (P4) according to IU-TRI-03", "expressions": [{"id": "expr-1795261066341-oqqnf0", "xmlId": "C-DM-07-py", "language": {"name": "Python", "version": "3", "publicationYear": "", "uri": ""}, "form": "text", "body": "from datetime import timedelta\nLIMIT = {'P1 - Critical': 1, 'P2 - High': 7, 'P3 - Medium': 14, 'P4 - Low': 30}\n\ndef check(priority, triaged_on, due_date):\n    return due_date - triaged_on > timedelta(days=LIMIT[priority])  # True = violation", "uri": ""}, {"id": "expr-1795261066341-me0qiq", "xmlId": "C-DM-07-sparql", "language": {"name": "SPARQL", "version": "1.1", "publicationYear": "2013", "uri": ""}, "form": "text", "body": "PREFIX bcf: <https://example.org/bcf#>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nASK {  # true = violation\n  ?t a bcf:Topic ; bcf:topicType \"Defect\" ; bcf:priority ?p ; bcf:dueDate ?due ; bcf:triagedOn ?tri .\n  VALUES (?p ?days) { (\"P1 - Critical\" 1) (\"P2 - High\" 7) (\"P3 - Medium\" 14) (\"P4 - Low\" 30) }\n  FILTER ( (xsd:date(?due) - xsd:date(?tri)) > xsd:dayTimeDuration(CONCAT(\"P\", STR(?days), \"D\")) )\n}", "uri": ""}]}, {"id": "C-DM-09", "businessRuleIds": ["BR-DM-09"], "informationUnitIds": ["IU-ASG-03", "IU-ASG-02"], "description": "count(IU-ASG-03) = 1 AND IU-ASG-03 IN extensions.xml/Users AND IU-ASG-03 belongs to IU-ASG-02", "expressions": [{"id": "expr-1795261066341-qb7i19", "xmlId": "C-DM-09-sch", "language": {"name": "Schematron", "version": "ISO/IEC 19757-3:2020", "publicationYear": "2020", "uri": "http://purl.oclc.org/dsdl/schematron"}, "form": "xml", "body": "<sch:schema xmlns:sch=\"http://purl.oclc.org/dsdl/schematron\" queryBinding=\"xslt2\">\n              <sch:let name=\"users\" value=\"doc('../extensions.xml')/Extensions/Users/User\"/>\n              <sch:pattern id=\"bcf-assignee\">\n                <sch:rule context=\"Markup/Topic[@TopicStatus = ('Assigned', 'In progress', 'Resolved', 'Reopened')]\">\n                  <sch:assert test=\"count(AssignedTo) = 1\">BR-DM-09: exactly one assignee.</sch:assert>\n                  <sch:assert test=\"AssignedTo = $users\">BR-DM-09: assignee is not a project user.</sch:assert>\n                </sch:rule>\n              </sch:pattern>\n            </sch:schema>", "uri": ""}]}], "subERs": [], "fullTitle": "Defect assignment notice", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER04", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the defect assignment notice", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "Assignment sets AssignedTo and DueDate of the topic."}], "subErs": []}, "DataObject_Rectification": {"id": "4efac59c-6677-552d-ae4d-30be580cf160", "guid": "4efac59c-6677-552d-ae4d-30be580cf160", "shortTitle": "ER_RectificationReport", "name": "Rectification report", "description": "Report of the trade subcontractor that the defect has been rectified, with evidence.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-RES-01", "name": "Rectification description", "dataType": "String / Text", "isMandatory": true, "definition": "What was done to rectify the defect.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-scbsyu", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Comment", "description": ""}], "subInformationUnits": []}, {"id": "IU-RES-02", "name": "Completed on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time of completion.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-almluw", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Date", "description": ""}], "subInformationUnits": []}, {"id": "IU-RES-03", "name": "Completed by", "dataType": "String / Text", "isMandatory": true, "definition": "Assignee who reports the rectification.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-vtez13", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Author", "description": ""}], "subInformationUnits": []}, {"id": "IU-RES-04", "name": "After photograph", "dataType": "Image", "isMandatory": true, "definition": "Photograph of the rectified work.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-rgjbz8", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Viewpoint/@Guid", "description": "Viewpoint whose snapshot is the photograph."}], "subInformationUnits": []}, {"id": "IU-RES-05", "name": "Cause found", "dataType": "String / Text", "isMandatory": false, "definition": "Cause of the defect found during rectification.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-RES-06", "name": "Requested status", "dataType": "String / Text", "isMandatory": true, "definition": "Status requested by the assignee; Resolved.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-nu23wa", "basis": "BCF 3.0", "name": "Markup/Topic/@TopicStatus", "description": ""}], "subInformationUnits": []}], "constraints": [{"id": "C-DM-10", "businessRuleIds": ["BR-DM-10"], "informationUnitIds": ["IU-RES-01", "IU-RES-04", "IU-RES-06"], "description": "IU-RES-06 = 'Resolved' IMPLIES IU-RES-01 is not empty AND IU-RES-04 is not empty", "expressions": []}], "subERs": [], "fullTitle": "Rectification report", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER05", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the rectification report", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "Added to the topic as a comment with a viewpoint."}], "subErs": []}, "DataObject_Verification": {"id": "1e5828b3-f59e-50b1-83d7-0ed2aab21955", "guid": "1e5828b3-f59e-50b1-83d7-0ed2aab21955", "shortTitle": "ER_VerificationRecord", "name": "Verification record", "description": "Result of the re-inspection of a rectified defect by the site quality inspector.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-VER-01", "name": "Verified on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time of the re-inspection.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-u80wgh", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Date", "description": ""}], "subInformationUnits": []}, {"id": "IU-VER-02", "name": "Verified by", "dataType": "String / Text", "isMandatory": true, "definition": "Inspector who verified the rectification.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-fd9pha", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Author", "description": ""}], "subInformationUnits": []}, {"id": "IU-VER-03", "name": "Verification result", "dataType": "String / Text", "isMandatory": true, "definition": "Passed or Failed.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066342-685dsh", "text": "확인 결과", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-hwfp3g", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Comment", "description": "Comment text starts with 'Verification: Passed' or 'Verification: Failed'."}], "subInformationUnits": []}, {"id": "IU-VER-04", "name": "Remarks", "dataType": "String / Text", "isMandatory": false, "definition": "Reason for a failed verification or other remarks.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-k20x2g", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Comment", "description": ""}], "subInformationUnits": []}, {"id": "IU-VER-05", "name": "Verification photograph", "dataType": "Image", "isMandatory": false, "definition": "Photograph taken during verification.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-eh4zps", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Viewpoint/@Guid", "description": ""}], "subInformationUnits": []}, {"id": "IU-VER-06", "name": "Failed verifications", "dataType": "Numeric", "isMandatory": true, "definition": "Number of failed verifications of this defect so far.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}], "constraints": [{"id": "C-DM-13", "businessRuleIds": ["BR-DM-13"], "informationUnitIds": ["IU-VER-06"], "description": "IU-VER-06 > 2 IMPLIES escalation to the project manager", "expressions": []}], "subERs": [], "fullTitle": "Verification record", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER06", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the verification record", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "Added to the topic as a comment; the status becomes Closed-ready or Reopened."}], "subErs": []}, "DataObject_Closure": {"id": "1824a928-4180-5eac-a5ae-de918b5bb2ec", "guid": "1824a928-4180-5eac-a5ae-de918b5bb2ec", "shortTitle": "ER_ClosureRecord", "name": "Defect closure record", "description": "Formal closure of the defect by the BIM coordinator after a passed verification.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-CLO-01", "name": "Final status", "dataType": "String / Text", "isMandatory": true, "definition": "Closed (or Rejected for defects rejected at triage).", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-ab74p4", "basis": "BCF 3.0", "name": "Markup/Topic/@TopicStatus", "description": ""}], "subInformationUnits": []}, {"id": "IU-CLO-02", "name": "Closed on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time of closure.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-nedafg", "basis": "BCF 3.0", "name": "Markup/Topic/ModifiedDate", "description": ""}], "subInformationUnits": []}, {"id": "IU-CLO-03", "name": "Closed by", "dataType": "String / Text", "isMandatory": true, "definition": "User who closed the topic.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-t0v3vi", "basis": "BCF 3.0", "name": "Markup/Topic/ModifiedAuthor", "description": ""}], "subInformationUnits": []}, {"id": "IU-CLO-04", "name": "Days to close", "dataType": "Numeric", "isMandatory": true, "definition": "Derived: Closed on minus Created on.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-CLO-05", "name": "Closure sign-off", "dataType": "Document (PDF, DOCX, etc.)", "isMandatory": false, "definition": "Signed closure record, if the contract requires one.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-bkpfcl", "basis": "BCF 3.0", "name": "Markup/Topic/DocumentReferences/DocumentReference", "description": ""}], "subInformationUnits": []}], "constraints": [], "subERs": [], "fullTitle": "Defect closure record", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER07", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the defect closure record", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "TopicStatus = Closed."}], "subErs": []}, "DataObject_StatusReport": {"id": "5361a9a6-ee4e-503f-a81d-eae8f8f15bcb", "guid": "5361a9a6-ee4e-503f-a81d-eae8f8f15bcb", "shortTitle": "ER_DefectStatusReport", "name": "Defect status report", "description": "Daily summary and analysis of all defect topics for the owner's representative.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-RPT-01", "name": "Reporting date", "dataType": "Date / Time", "isMandatory": true, "definition": "Cut-off date of the report.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-RPT-02", "name": "Defect register extract", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "All defect topics at the cut-off date.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-ns9ata", "basis": "BCF 3.0", "name": "BCF file (.bcfzip)", "description": "All topics with TopicType = Defect."}], "subInformationUnits": []}, {"id": "IU-RPT-03", "name": "Defects by status", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Number of defects per status.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-rj563j", "basis": "BCF 3.0", "name": "Markup/Topic/@TopicStatus", "description": "Aggregated."}], "subInformationUnits": []}, {"id": "IU-RPT-04", "name": "Defects by priority", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Number of open defects per priority.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-7rx964", "basis": "BCF 3.0", "name": "Markup/Topic/Priority", "description": "Aggregated."}], "subInformationUnits": []}, {"id": "IU-RPT-05", "name": "Defects by trade", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Number of defects per trade.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-hwuxsd", "basis": "BCF 3.0", "name": "Markup/Topic/Labels/Label", "description": "Aggregated by trade label."}], "subInformationUnits": []}, {"id": "IU-RPT-06", "name": "Overdue defects", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Defects that are not Closed or Rejected and whose due date has passed.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066342-ahby2y", "text": "기한 초과 하자", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-6pvwfh", "basis": "BCF 3.0", "name": "Markup/Topic/DueDate", "description": ""}], "subInformationUnits": []}, {"id": "IU-RPT-07", "name": "Average days to close", "dataType": "Numeric", "isMandatory": true, "definition": "Mean of days to close over the defects closed so far.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-RPT-08", "name": "Prepared by", "dataType": "String / Text", "isMandatory": true, "definition": "Quality manager who prepared the report.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}], "constraints": [{"id": "C-DM-14", "businessRuleIds": ["BR-DM-14"], "informationUnitIds": ["IU-RPT-01", "IU-RPT-03", "IU-RPT-04", "IU-RPT-05", "IU-RPT-06", "IU-RPT-07"], "description": "A report exists for every working day (IU-RPT-01) AND IU-RPT-06 lists every defect with IU-LOG-015 NOT IN (Closed, Rejected) AND due date < IU-RPT-01", "expressions": [{"id": "expr-1795261066342-f0y1f8", "xmlId": "C-DM-14-sparql", "language": {"name": "SPARQL", "version": "1.1", "publicationYear": "2013", "uri": ""}, "form": "text", "body": "PREFIX bcf: <https://example.org/bcf#>\nPREFIX rpt: <https://example.org/defect-report#>\nASK {  # true = violation: an overdue defect is missing from the report\n  ?r a rpt:DefectStatusReport ; rpt:reportingDate ?cut .\n  ?t a bcf:Topic ; bcf:topicType \"Defect\" ; bcf:topicStatus ?s ; bcf:dueDate ?due .\n  FILTER ( ?s NOT IN (\"Closed\", \"Rejected\") && ?due < ?cut )\n  FILTER NOT EXISTS { ?r rpt:overdueDefect ?t }\n}", "uri": ""}]}], "subERs": [], "fullTitle": "Defect status report", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER08", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the defect status report", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "Computed from all topics with TopicType = Defect in the BCF file or BCF API."}], "subErs": []}}, "erLibrary": [], "headerData": {"title": "Defect Management Using BCF", "authors": [{"type": "person", "id": "author-1", "givenName": "Ghang", "familyName": "Lee", "middleInitial": "", "affiliation": "Yonsei University", "uri": "glee@yonsei.ac.kr", "prefix": "", "suffix": "", "postnominalDesignation": "", "affiliationOrgIds": [], "isLead": true, "affiliationOrgId": ""}, {"type": "organization", "id": "author-2", "name": "Building Informatics Group (BIG), Yonsei University", "uri": ""}], "organization": "", "version": "1.0", "creationDate": "", "status": "WD", "language": "EN", "region": "KR", "projectStages": ["production"], "useCategories": ["Construction Quality Management", "Issue Management"], "summary": "The general contractor identifies construction defects on site, logs each defect as a BIM Collaboration Format (BCF) topic linked to the building model, triages and assigns it to the responsible trade subcontractor, verifies the rectification and closes the topic. A daily defect status report summarises the BCF topics for the owner's representative.", "revisionHistory": [{"date": "2026-11-20", "description": "Tutorial sample created: process map, eight ERs from the defect management forms, BCF 3.0 mappings, 14 business rules and constraints"}], "contributors": [], "copyright": "Copyright 2026 Building Informatics Group (BIG), Yonsei University. Tutorial sample; fictitious project data; not normative.", "keywords": ["defect management", "BCF", "quality control", "punch list", "issue tracking"], "relatedStandards": [], "externalReferences": [], "objectives": "Aim: replace paper punch lists and spreadsheet defect logs with BCF topics that carry location, photographs, status and responsibility, so that every party works on the same defect record.", "benefits": "One defect record from identification to closure; defects located in the model; measurable response times; fewer disputes about responsibility.", "limitations": "BCF does not define defect-specific fields such as severity or root cause; they are carried as labels or comments by project convention (see the BCF extensions of the project).", "actors": "", "preconditions": "", "postconditions": "", "triggeringEvents": "", "requiredCapabilities": "", "complianceCriteria": "", "actorsList": [{"id": "actor-gc", "name": "General contractor", "external": false, "bpmnShapeName": "Participant_GC", "role": "", "subActors": [{"id": "actor-gc-qi", "name": "Site quality inspector", "role": "", "bpmnShapeName": "Lane_QualityInspector"}, {"id": "actor-gc-bim", "name": "BIM coordinator", "role": "", "bpmnShapeName": "Lane_BIMCoordinator"}, {"id": "actor-gc-qm", "name": "Quality manager", "role": "", "bpmnShapeName": "Lane_QualityManager"}], "bpmnId": "Participant_GC"}, {"id": "actor-sub", "name": "Trade subcontractor", "external": false, "bpmnShapeName": "Participant_Sub", "role": "", "subActors": [], "bpmnId": "Participant_Sub"}, {"id": "actor-own", "name": "Owner's representative", "external": true, "bpmnShapeName": "Participant_Owner", "role": "", "subActors": [], "bpmnId": "Participant_Owner"}], "shortTitle": "DMBCF", "subTitle": "Identification, logging, triage, assignment, resolution, verification and closure of construction defects, with reporting and analysis (tutorial sample)", "localShortTitle": "하자관리", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Tutorial sample created: process map, eight ERs from the defect management forms, BCF 3.0 mappings, 14 business rules and constraints", "changedBy": "author-1", "changes": []}], "publisher": {"name": "Building Informatics Group (BIG), Yonsei University", "location": "Seoul, Republic of Korea"}, "idmCode": "IDM-KR-DMBCF-01", "idmGuid": "afbf4728-82f8-53f9-b57a-e48bc3523bc1", "localDocumentStatus": "", "localCode": "", "idmXsdVersion": "2.0", "idmXsdVersionConfidence": "high", "aimAndScope": "Aim: replace paper punch lists and spreadsheet defect logs with BCF topics that carry location, photographs, status and responsibility, so that every party works on the same defect record.", "uses": [{"verb": "Construction", "noun": "Quality Management"}, {"verb": "Issue", "noun": "Management"}], "useClassification": null, "regions": ["KR"], "projectStagesIso": ["production"], "projectStagesAia": [], "projectStagesRiba": [], "customProjectPhases": [{"id": "custom-phase-1", "classificationName": "Korean construction project phases (건설사업 단계)", "phaseName": "Construction (시공)"}], "benefitKeywords": ["traceability", "response time"], "references": "[basis] ISO 29481-1:2025 Building information models - Information delivery manual - Part 1: Methodology and format\nbuildingSMART International, BIM Collaboration Format (BCF) 3.0, BCF-XML\nISO 19650-2:2018 Organization and digitization of information about buildings and civil engineering works, including BIM - Information management using building information modelling - Part 2: Delivery phase of the assets\nISO 9001:2015 Quality management systems - Requirements, 10.2 Nonconformity and corrective action", "requiredResources": "BCF 3.0 capable issue management tool or common data environment (CDE); IFC 4.3 coordination model; mobile device with camera for site inspection.", "requiredCompetencies": "Site inspection and quality control; use of a BCF viewer; knowledge of the project quality plan.", "constructionEntities": ["Office building", "Healthcare facility"], "additionalDescription": "Sample status = Tutorial sample for xPPM neo-Seoul. Project, companies, people and regulatory references are fictitious or illustrative.", "ucGuid": "df6a2294-7003-564e-858d-042ce4d4aca4", "ucShortTitle": "DMBCF_UC", "ucFullTitle": "Defect Management Using BCF - Use case", "ucIdmCode": "IDM-KR-DMBCF-01-UC", "ucSubTitle": "", "ucDocumentStatus": "WD", "ucVersion": "1.0", "ucLocalCode": "", "ucLocalDocumentStatus": "", "ucChangeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Use case drafted", "changedBy": "author-1", "changes": []}], "summaryFigures": [], "aimAndScopeFigures": [], "benefitsFigures": [], "limitationsFigures": [], "bcmGuid": "224ea1bc-d9fb-5f9e-ba4d-1f1e269f5d26", "bcmShortTitle": "DMBCF_BCM", "bcmFullTitle": "Defect Management Using BCF - Process map", "bcmIdmCode": "IDM-KR-DMBCF-01-BCM", "bcmSubTitle": "", "bcmDocumentStatus": "WD", "bcmVersion": "1.0", "bcmLocalCode": "", "bcmLocalDocumentStatus": "", "bcmChangeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Process map drafted", "changedBy": "author-1", "changes": []}], "pmId": "pm-dmbcf", "pmDiagramName": "Defect management using BCF", "importedActorsList": [{"id": "actor-gc", "name": "General contractor", "external": false, "bpmnShapeName": "Participant_GC", "role": "", "subActors": [{"id": "actor-gc-qi", "name": "Site quality inspector", "role": "", "bpmnShapeName": "Lane_QualityInspector"}, {"id": "actor-gc-bim", "name": "BIM coordinator", "role": "", "bpmnShapeName": "Lane_BIMCoordinator"}, {"id": "actor-gc-qm", "name": "Quality manager", "role": "", "bpmnShapeName": "Lane_QualityManager"}]}, {"id": "actor-sub", "name": "Trade subcontractor", "external": false, "bpmnShapeName": "Participant_Sub", "role": "", "subActors": []}, {"id": "actor-own", "name": "Owner's representative", "external": true, "bpmnShapeName": "Participant_Owner", "role": "", "subActors": []}], "rootERName": "Defect management information", "rootERId": "47f29b3f-c3d9-5ee8-810b-904b2763dc4e", "dataObjectAndErLinks": [{"id": "doer-1", "doId": "DataObject_Inspection", "erId": "784ec386-7401-5665-8a09-b19e21022595"}, {"id": "doer-2", "doId": "DataObject_Topic", "erId": "5619d897-1698-5481-854a-ad111a34116f"}, {"id": "doer-3", "doId": "DataObject_Triage", "erId": "31aad244-33ac-5f23-81f6-113426f23d96"}, {"id": "doer-4", "doId": "DataObject_Assignment", "erId": "a4642088-e79b-5489-9e28-695bc45c760b"}, {"id": "doer-5", "doId": "DataObject_Rectification", "erId": "4efac59c-6677-552d-ae4d-30be580cf160"}, {"id": "doer-6", "doId": "DataObject_Verification", "erId": "1e5828b3-f59e-50b1-83d7-0ed2aab21955"}, {"id": "doer-7", "doId": "DataObject_Closure", "erId": "1824a928-4180-5eac-a5ae-de918b5bb2ec"}, {"id": "doer-8", "doId": "DataObject_StatusReport", "erId": "5361a9a6-ee4e-503f-a81d-eae8f8f15bcb"}], "mappingSchemas": [{"value": "BCF 3.0", "label": "BCF 3.0", "version": "3.0", "uri": "https://github.com/buildingSMART/BCF-XML/tree/release_3_0", "description": "buildingSMART BIM Collaboration Format, BCF-XML 3.0 (markup.bcf, viewpoint .bcfv, extensions.xml)", "placeholder": "e.g. Markup/Topic/Title", "elements": [{"name": "Markup"}, {"name": "Markup/Header"}, {"name": "Markup/Header/Files"}, {"name": "Markup/Header/Files/File", "description": "Model file the topic refers to"}, {"name": "Markup/Header/Files/File/@IfcProject"}, {"name": "Markup/Header/Files/File/@IfcSpatialStructureElement"}, {"name": "Markup/Header/Files/File/@IsExternal"}, {"name": "Markup/Header/Files/File/Filename"}, {"name": "Markup/Header/Files/File/Date"}, {"name": "Markup/Header/Files/File/Reference"}, {"name": "Markup/Topic", "description": "One topic (issue) per markup.bcf"}, {"name": "Markup/Topic/@Guid", "description": "Unique identifier of the topic"}, {"name": "Markup/Topic/@ServerAssignedId", "description": "Identifier assigned by the BCF server, e.g. a sequential number"}, {"name": "Markup/Topic/@TopicType", "description": "Type of the topic (value from extensions.xml)"}, {"name": "Markup/Topic/@TopicStatus", "description": "Status of the topic (value from extensions.xml)"}, {"name": "Markup/Topic/ReferenceLinks"}, {"name": "Markup/Topic/ReferenceLinks/ReferenceLink"}, {"name": "Markup/Topic/Title", "description": "Title of the topic"}, {"name": "Markup/Topic/Priority", "description": "Priority (value from extensions.xml)"}, {"name": "Markup/Topic/Index"}, {"name": "Markup/Topic/Labels"}, {"name": "Markup/Topic/Labels/Label", "description": "Label (value from extensions.xml)"}, {"name": "Markup/Topic/CreationDate", "description": "Date and time of creation"}, {"name": "Markup/Topic/CreationAuthor", "description": "User who created the topic"}, {"name": "Markup/Topic/ModifiedDate", "description": "Date and time of the last change"}, {"name": "Markup/Topic/ModifiedAuthor", "description": "User who made the last change"}, {"name": "Markup/Topic/DueDate", "description": "Date and time by which the topic shall be resolved"}, {"name": "Markup/Topic/AssignedTo", "description": "User the topic is assigned to"}, {"name": "Markup/Topic/Stage", "description": "Project stage (value from extensions.xml)"}, {"name": "Markup/Topic/Description", "description": "Description of the topic"}, {"name": "Markup/Topic/BimSnippet"}, {"name": "Markup/Topic/BimSnippet/@SnippetType"}, {"name": "Markup/Topic/BimSnippet/@IsExternal"}, {"name": "Markup/Topic/BimSnippet/Reference"}, {"name": "Markup/Topic/BimSnippet/ReferenceSchema"}, {"name": "Markup/Topic/DocumentReferences"}, {"name": "Markup/Topic/DocumentReferences/DocumentReference", "description": "Reference to a document in the BCF file or a URL"}, {"name": "Markup/Topic/DocumentReferences/DocumentReference/@Guid"}, {"name": "Markup/Topic/DocumentReferences/DocumentReference/DocumentGuid"}, {"name": "Markup/Topic/DocumentReferences/DocumentReference/Url"}, {"name": "Markup/Topic/DocumentReferences/DocumentReference/Description"}, {"name": "Markup/Topic/RelatedTopics"}, {"name": "Markup/Topic/RelatedTopics/RelatedTopic"}, {"name": "Markup/Topic/RelatedTopics/RelatedTopic/@Guid", "description": "GUID of a related topic"}, {"name": "Markup/Topic/Comments"}, {"name": "Markup/Topic/Comments/Comment", "description": "Comment on the topic"}, {"name": "Markup/Topic/Comments/Comment/@Guid"}, {"name": "Markup/Topic/Comments/Comment/Date"}, {"name": "Markup/Topic/Comments/Comment/Author"}, {"name": "Markup/Topic/Comments/Comment/Comment"}, {"name": "Markup/Topic/Comments/Comment/Viewpoint"}, {"name": "Markup/Topic/Comments/Comment/Viewpoint/@Guid"}, {"name": "Markup/Topic/Comments/Comment/ModifiedDate"}, {"name": "Markup/Topic/Comments/Comment/ModifiedAuthor"}, {"name": "Markup/Topic/Viewpoints"}, {"name": "Markup/Topic/Viewpoints/ViewPoint", "description": "Viewpoint of the topic"}, {"name": "Markup/Topic/Viewpoints/ViewPoint/@Guid"}, {"name": "Markup/Topic/Viewpoints/ViewPoint/Viewpoint"}, {"name": "Markup/Topic/Viewpoints/ViewPoint/Snapshot", "description": "Snapshot image (PNG or JPEG) of the viewpoint"}, {"name": "Markup/Topic/Viewpoints/ViewPoint/Index"}, {"name": "VisualizationInfo", "description": "Viewpoint file (.bcfv)"}, {"name": "VisualizationInfo/@Guid"}, {"name": "VisualizationInfo/Components"}, {"name": "VisualizationInfo/Components/Selection"}, {"name": "VisualizationInfo/Components/Selection/Component"}, {"name": "VisualizationInfo/Components/Selection/Component/@IfcGuid", "description": "IFC GlobalId of a selected component"}, {"name": "VisualizationInfo/Components/Selection/Component/OriginatingSystem"}, {"name": "VisualizationInfo/Components/Selection/Component/AuthoringToolId"}, {"name": "VisualizationInfo/Components/Visibility"}, {"name": "VisualizationInfo/Components/Visibility/@DefaultVisibility"}, {"name": "VisualizationInfo/Components/Visibility/ViewSetupHints"}, {"name": "VisualizationInfo/Components/Visibility/ViewSetupHints/@SpacesVisible"}, {"name": "VisualizationInfo/Components/Visibility/ViewSetupHints/@SpaceBoundariesVisible"}, {"name": "VisualizationInfo/Components/Visibility/ViewSetupHints/@OpeningsVisible"}, {"name": "VisualizationInfo/Components/Visibility/Exceptions"}, {"name": "VisualizationInfo/Components/Visibility/Exceptions/Component"}, {"name": "VisualizationInfo/Components/Visibility/Exceptions/Component/@IfcGuid"}, {"name": "VisualizationInfo/Components/Visibility/Exceptions/Component/OriginatingSystem"}, {"name": "VisualizationInfo/Components/Visibility/Exceptions/Component/AuthoringToolId"}, {"name": "VisualizationInfo/Components/Coloring"}, {"name": "VisualizationInfo/Components/Coloring/Color"}, {"name": "VisualizationInfo/Components/Coloring/Color/@Color"}, {"name": "VisualizationInfo/Components/Coloring/Color/Components"}, {"name": "VisualizationInfo/Components/Coloring/Color/Components/Component"}, {"name": "VisualizationInfo/Components/Coloring/Color/Components/Component/@IfcGuid"}, {"name": "VisualizationInfo/Components/Coloring/Color/Components/Component/OriginatingSystem"}, {"name": "VisualizationInfo/Components/Coloring/Color/Components/Component/AuthoringToolId"}, {"name": "VisualizationInfo/OrthogonalCamera", "description": "Orthogonal camera of the viewpoint"}, {"name": "VisualizationInfo/OrthogonalCamera/CameraViewPoint"}, {"name": "VisualizationInfo/OrthogonalCamera/CameraDirection"}, {"name": "VisualizationInfo/OrthogonalCamera/CameraUpVector"}, {"name": "VisualizationInfo/OrthogonalCamera/ViewToWorldScale"}, {"name": "VisualizationInfo/OrthogonalCamera/AspectRatio"}, {"name": "VisualizationInfo/PerspectiveCamera", "description": "Perspective camera of the viewpoint"}, {"name": "VisualizationInfo/PerspectiveCamera/CameraViewPoint"}, {"name": "VisualizationInfo/PerspectiveCamera/CameraDirection"}, {"name": "VisualizationInfo/PerspectiveCamera/CameraUpVector"}, {"name": "VisualizationInfo/PerspectiveCamera/FieldOfView"}, {"name": "VisualizationInfo/PerspectiveCamera/AspectRatio"}, {"name": "VisualizationInfo/Lines"}, {"name": "VisualizationInfo/Lines/Line"}, {"name": "VisualizationInfo/ClippingPlanes"}, {"name": "VisualizationInfo/ClippingPlanes/ClippingPlane"}, {"name": "VisualizationInfo/Bitmaps"}, {"name": "VisualizationInfo/Bitmaps/Bitmap"}, {"name": "Extensions", "description": "Project vocabulary file (extensions.xml)"}, {"name": "Extensions/TopicTypes"}, {"name": "Extensions/TopicTypes/TopicType"}, {"name": "Extensions/TopicStatuses"}, {"name": "Extensions/TopicStatuses/TopicStatus"}, {"name": "Extensions/Priorities"}, {"name": "Extensions/Priorities/Priority"}, {"name": "Extensions/TopicLabels"}, {"name": "Extensions/TopicLabels/TopicLabel"}, {"name": "Extensions/Users"}, {"name": "Extensions/Users/User"}, {"name": "Extensions/SnippetTypes"}, {"name": "Extensions/SnippetTypes/SnippetType"}, {"name": "Extensions/Stages"}, {"name": "Extensions/Stages/Stage"}]}], "businessRules": [{"id": "BR-DM-01", "name": "Unique defect identification", "statement": "Every defect shall have a globally unique identifier and a project defect number that is never reused.", "images": [], "commentary": [{"id": "c-1795261066337-p4y6e6", "text": "Commentary: the BCF topic GUID is the unique identifier; the defect number (e.g. DEF-0001) is the server-assigned id of the topic."}], "reference": "buildingSMART BCF-XML 3.0, markup.xsd (Topic/@Guid, Topic/@ServerAssignedId)"}, {"id": "BR-DM-02", "name": "Defect location", "statement": "Every defect shall be located by storey and space and, where it affects a modelled element, by the IFC GlobalId of that element.", "images": [], "commentary": [{"id": "c-1795261066338-26jyip", "text": "Commentary: the element is referenced as a selected component in the viewpoint of the BCF topic."}], "reference": ""}, {"id": "BR-DM-03", "name": "Photographic evidence", "statement": "Every defect found in an inspection shall include at least one photograph of the defect, carried as the snapshot of the first viewpoint of the BCF topic.", "images": [], "commentary": [], "reference": ""}, {"id": "BR-DM-04", "name": "Controlled vocabularies", "statement": "The topic type, topic status, priority, labels and users of a defect shall be values defined in the project BCF extensions (extensions.xml).", "images": [], "commentary": [{"id": "c-1795261066338-caqd7k", "text": "Commentary: topic type = Defect; statuses = Open, Assigned, In progress, Resolved, Reopened, Closed, Rejected; priorities = P1 - Critical, P2 - High, P3 - Medium, P4 - Low."}], "reference": "buildingSMART BCF-XML 3.0, extensions.xsd"}, {"id": "BR-DM-05", "name": "Defect status lifecycle", "statement": "The status of a defect shall change only along the transitions of the defect status lifecycle.", "images": [{"id": "fig-1795261066338-qwbuxz", "name": "Defect status lifecycle (BCF TopicStatus values)", "caption": "Defect status lifecycle (BCF TopicStatus values)", "type": "image/png", "data": "data:image/png;base64,"}], "commentary": [{"id": "c-1795261066338-mg6022", "text": "Commentary: a defect can be closed only from Resolved, and a Reopened defect returns to Assigned."}], "reference": ""}, {"id": "BR-DM-06", "name": "Triage deadline", "statement": "A logged defect shall be triaged within 2 working days of its creation date.", "images": [], "commentary": [], "reference": "Project quality plan, clause 7.3 Defect management (illustrative)"}, {"id": "BR-DM-07", "name": "Rectification period by priority", "statement": "The due date of a defect shall be no later than 1 day (P1 - Critical), 7 days (P2 - High), 14 days (P3 - Medium) or 30 days (P4 - Low) after triage.", "images": [{"id": "fig-1795261066338-keu9nv", "name": "Rectification period by priority", "caption": "Rectification period by priority", "type": "image/png", "data": "data:image/png;base64,"}], "commentary": [], "reference": "Project quality plan, clause 7.4 Response times (illustrative)"}, {"id": "BR-DM-08", "name": "Safety-critical defects", "statement": "A defect that is flagged as safety-critical shall have the priority P1 - Critical.", "images": [], "commentary": [{"id": "c-1795261066338-4qoxm7", "text": "Commentary: the area shall also be made safe immediately; this is a site instruction and is not checked from the data."}], "reference": "Occupational Safety and Health Act (Republic of Korea) (illustrative)"}, {"id": "BR-DM-09", "name": "Single responsible assignee", "statement": "An assigned defect shall have exactly one assignee, who is a registered project user of the responsible party.", "images": [], "commentary": [], "reference": ""}, {"id": "BR-DM-10", "name": "Evidence of rectification", "statement": "A defect shall be set to Resolved only with a rectification description and at least one photograph taken after rectification.", "images": [], "commentary": [], "reference": ""}, {"id": "BR-DM-11", "name": "Independent verification", "statement": "The person who verifies a rectification shall not be the assignee of the defect.", "images": [], "commentary": [{"id": "c-1795261066338-ooaac5", "text": "Commentary: segregation of duties; the verifier is normally the site quality inspector."}], "reference": "ISO 9001:2015, 8.6 Release of products and services"}, {"id": "BR-DM-12", "name": "Closure after passed verification", "statement": "A defect shall be closed only after a verification with the result Passed; a rejected defect shall record the reason for rejection.", "images": [], "commentary": [], "reference": ""}, {"id": "BR-DM-13", "name": "Escalation of repeated failures", "statement": "A defect whose rectification fails verification more than twice shall be escalated to the project manager.", "images": [], "commentary": [], "reference": ""}, {"id": "BR-DM-14", "name": "Daily defect status report", "statement": "A defect status report shall be issued every working day with the number of defects by status, priority and trade, the list of overdue defects and the average time to close.", "images": [], "commentary": [], "reference": "ISO 19650-2:2018, 5.7 Information model delivery (illustrative)"}]}, "exportedAt": "2026-11-20T10:00:00.000Z"}
"1373\" y=\"820\" />\n        <di:waypoint x=\"1420\" y=\"820\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_O2_di\" bpmnElement=\"Flow_O2\">\n        <di:waypoint x=\"1530\" y=\"820\" />\n        <di:waypoint x=\"1582\" y=\"820\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"DOA_01_di\" bpmnElement=\"DOA_01\">\n        <di:waypoint x=\"270\" y=\"100\" />\n        <di:waypoint x=\"292\" y=\"118\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"DIA_02_di\" bpmnElement=\"DIA_02\">\n        <di:waypoint x=\"310\" y=\"150\" />\n        <di:waypoint x=\"350\" y=\"205\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"DOA_02_di\" bpmnElement=\"DOA_02\">\n        <di:waypoint x=\"440\" y=\"262\" />\n        <di:waypoint x=\"462\" y=\"274\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"DOA_03_di\" bpmnElement=\"DOA_03\">\n        <di:waypoint x=\"545\" y=\"415\" />\n        <di:waypoint x=\"545\" y=\"440\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"DOA_04_di\" bpmnElement=\"DOA_04\">\n        <di:waypoint x=\"870\" y=\"405\" />\n        <di:waypoint x=\"892\" y=\"450\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"DOA_06_di\" bpmnElement=\"DOA_06\">\n        <di:waypoint x=\"1270\" y=\"100\" />\n        <di:waypoint x=\"1290\" y=\"115\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"DOA_07_di\" bpmnElement=\"DOA_07\">\n        <di:waypoint x=\"1560\" y=\"262\" />\n        <di:waypoint x=\"1582\" y=\"276\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"DOA_08_di\" bpmnElement=\"DOA_08\">\n        <di:waypoint x=\"1410\" y=\"400\" />\n        <di:waypoint x=\"1432\" y=\"450\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"DOA_05_di\" bpmnElement=\"DOA_05\">\n        <di:waypoint x=\"1000\" y=\"660\" />\n        <di:waypoint x=\"1022\" y=\"670\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"MessageFlow_Assignment_di\" bpmnElement=\"MessageFlow_Assignment\">\n        <di:waypoint x=\"815\" y=\"415\" />\n        <di:waypoint x=\"815\" y=\"612\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"822\" y=\"520\" width=\"90\" height=\"27\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"MessageFlow_Rectified_di\" bpmnElement=\"MessageFlow_Rectified\">\n        <di:waypoint x=\"1098\" y=\"612\" />\n        <di:waypoint x=\"1098\" y=\"98\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"1104\" y=\"520\" width=\"80\" height=\"27\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"MessageFlow_Report_di\" bpmnElement=\"MessageFlow_Report\">\n        <di:waypoint x=\"1355\" y=\"415\" />\n        <di:waypoint x=\"1355\" y=\"802\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"1362\" y=\"680\" width=\"80\" height=\"27\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNEdge>\n    </bpmndi:BPMNPlane>\n  </bpmndi:BPMNDiagram>\n</bpmn:definitions>\n", "erHierarchy": [{"id": "47f29b3f-c3d9-5ee8-810b-904b2763dc4e", "guid": "47f29b3f-c3d9-5ee8-810b-904b2763dc4e", "shortTitle": "ER_DefectManagement", "name": "Defect management information", "description": "Exchange requirements of the defect management process: one ER per form used in the process. Each ER is linked to a data object in the process map.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [], "constraints": [{"id": "C-DM-11", "businessRuleIds": ["BR-DM-11"], "informationUnitIds": ["IU-VER-02", "IU-ASG-03"], "description": "IU-VER-02 <> IU-ASG-03 (cross-ER constraint between the verification record and the assignment notice)", "expressions": [{"id": "expr-1795261066340-4ekbbw", "xmlId": "C-DM-11-ruleml", "language": {"name": "RuleML", "version": "1.03", "publicationYear": "", "uri": "http://ruleml.org/spec"}, "form": "xml", "body": "<Implies xmlns=\"http://ruleml.org/spec\">\n          <if>\n            <And>\n              <Atom>\n                <Rel>verifiedBy</Rel>\n                <Var>d</Var>\n                <Var>p</Var>\n              </Atom>\n              <Atom>\n                <Rel>assignedTo</Rel>\n                <Var>d</Var>\n                <Var>p</Var>\n              </Atom>\n            </And>\n          </if>\n          <then>\n            <Atom>\n              <Rel>violation</Rel>\n              <Ind>BR-DM-11</Ind>\n              <Var>d</Var>\n            </Atom>\n          </then>\n        </Implies>", "uri": ""}]}, {"id": "C-DM-12", "businessRuleIds": ["BR-DM-12"], "informationUnitIds": ["IU-CLO-01", "IU-VER-03", "IU-TRI-01", "IU-TRI-073"], "description": "IU-CLO-01 = 'Closed' IMPLIES last IU-VER-03 = 'Passed'; IU-CLO-01 = 'Rejected' IMPLIES IU-TRI-073 is not empty", "expressions": [{"id": "expr-1795261066340-wqz8up", "xmlId": "C-DM-12-lrml", "language": {"name": "LegalRuleML", "version": "1.0", "publicationYear": "2021", "uri": "http://docs.oasis-open.org/legalruleml/ns/v1.0/"}, "form": "xml", "body": "<lrml:LegalRuleML xmlns:lrml=\"http://docs.oasis-open.org/legalruleml/ns/v1.0/\" xmlns:ruleml=\"http://ruleml.org/spec\">\n          <lrml:Statements key=\"dm12\">\n            <lrml:PrescriptiveStatement key=\"ps-dm12\">\n              <ruleml:Rule closure=\"universal\">\n                <ruleml:if>\n                  <ruleml:Naf>\n                    <ruleml:Atom>\n                      <ruleml:Rel>verificationPassed</ruleml:Rel>\n                      <ruleml:Var>d</ruleml:Var>\n                    </ruleml:Atom>\n                  </ruleml:Naf>\n                </ruleml:if>\n                <ruleml:then>\n                  <lrml:Prohibition>\n                    <ruleml:Atom>\n                      <ruleml:Rel>close</ruleml:Rel>\n                      <ruleml:Var>d</ruleml:Var>\n                    </ruleml:Atom>\n                  </lrml:Prohibition>\n                </ruleml:then>\n              </ruleml:Rule>\n            </lrml:PrescriptiveStatement>\n          </lrml:Statements>\n        </lrml:LegalRuleML>", "uri": ""}]}], "subERs": [{"id": "784ec386-7401-5665-8a09-b19e21022595", "guid": "784ec386-7401-5665-8a09-b19e21022595", "shortTitle": "ER_DefectInspection", "name": "Defect inspection form", "description": "Information the site quality inspector records on site when a defect is identified (paper or mobile form).", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-INS-01", "name": "Inspection number", "dataType": "String / Text", "isMandatory": true, "definition": "Sequential number of the inspection form, e.g. INS-3F-027.", "definitionFigures": [], "synonyms": [], "examples": "INS-3F-027", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-INS-02", "name": "Inspected on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time of the inspection at which the defect was found.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-y9wcv7", "basis": "BCF 3.0", "name": "Markup/Topic/CreationDate", "description": "Copied to the topic creation date when the topic is logged."}], "subInformationUnits": []}, {"id": "IU-INS-03", "name": "Inspected by", "dataType": "String / Text", "isMandatory": true, "definition": "Name and e-mail address of the inspector who found the defect.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-muqgv6", "basis": "BCF 3.0", "name": "Markup/Topic/CreationAuthor", "description": "E-mail address of a user in extensions.xml."}], "subInformationUnits": []}, {"id": "IU-INS-04", "name": "Location", "dataType": "String / Text", "isMandatory": true, "definition": "Where the defect is, described by storey, space and grid reference.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066340-93lq22", "text": "위치", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": [{"id": "IU-INS-041", "name": "Storey", "dataType": "String / Text", "isMandatory": true, "definition": "Name of the building storey.", "definitionFigures": [], "synonyms": [], "examples": "3F", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-vc3un6", "basis": "IFC 4x3 ADD2", "name": "IfcBuildingStorey.Name", "description": ""}, {"id": "CEE-1795261066340-nv133r", "basis": "BCF 3.0", "name": "Markup/Header/Files/File/@IfcSpatialStructureElement", "description": "GlobalId of the storey."}], "subInformationUnits": []}, {"id": "IU-INS-042", "name": "Space", "dataType": "String / Text", "isMandatory": true, "definition": "Name or number of the space or zone.", "definitionFigures": [], "synonyms": [], "examples": "Corridor C-3F-02", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-ziyujp", "basis": "IFC 4x3 ADD2", "name": "IfcSpace.Name", "description": ""}], "subInformationUnits": []}, {"id": "IU-INS-043", "name": "Grid reference", "dataType": "String / Text", "isMandatory": false, "definition": "Nearest grid intersection, e.g. C/4.", "definitionFigures": [], "synonyms": [], "examples": "C/4", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-9nimqo", "basis": "IFC 4x3 ADD2", "name": "IfcGridAxis.AxisTag", "description": ""}], "subInformationUnits": []}]}, {"id": "IU-INS-05", "name": "Affected element", "dataType": "String / Text", "isMandatory": false, "definition": "Tag or IFC GlobalId of the building element that has the defect, if it is modelled.", "definitionFigures": [], "synonyms": [], "examples": "D-3F-12 (2pQe7N1Xr9hO0sYcJk4b3T)", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-k571ti", "basis": "BCF 3.0", "name": "VisualizationInfo/Components/Selection/Component/@IfcGuid", "description": "Selected component of the first viewpoint."}, {"id": "CEE-1795261066340-grixpp", "basis": "IFC 4x3 ADD2", "name": "IfcRoot.GlobalId", "description": ""}], "subInformationUnits": []}, {"id": "IU-INS-06", "name": "Defect description", "dataType": "String / Text", "isMandatory": true, "definition": "What is wrong, in plain words.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066340-tbay5a", "text": "하자 내용", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-886fsv", "basis": "BCF 3.0", "name": "Markup/Topic/Description", "description": ""}], "subInformationUnits": []}, {"id": "IU-INS-07", "name": "Trade", "dataType": "String / Text", "isMandatory": true, "definition": "Work package or trade that the defect belongs to, e.g. Doors and hardware.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066340-k2bcjt", "text": "Work package", "lang": "en"}, {"id": "syn-1795261066340-3zldy1", "text": "공종", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-5t53xt", "basis": "BCF 3.0", "name": "Markup/Topic/Labels/Label", "description": "Trade label, e.g. Trade: Doors and hardware."}], "subInformationUnits": []}, {"id": "IU-INS-08", "name": "Photograph", "dataType": "Image", "isMandatory": true, "definition": "Photograph of the defect taken on site.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066340-sw0rf5", "text": "사진", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-zdb5ch", "basis": "BCF 3.0", "name": "Markup/Topic/Viewpoints/ViewPoint/Snapshot", "description": "PNG or JPEG snapshot of the first viewpoint."}], "subInformationUnits": []}, {"id": "IU-INS-09", "name": "Possible safety hazard", "dataType": "Boolean", "isMandatory": true, "definition": "True if the inspector thinks the defect may endanger people.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-7u2e5d", "basis": "BCF 3.0", "name": "Markup/Topic/Labels/Label", "description": "Label 'Safety' when true."}], "subInformationUnits": []}, {"id": "IU-INS-10", "name": "Inspection reference", "dataType": "String / Text", "isMandatory": false, "definition": "Inspection and test plan (ITP) item or checklist under which the defect was found.", "definitionFigures": [], "synonyms": [], "examples": "ITP-DH-04 Fire door installation", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066340-nyc3xq", "basis": "BCF 3.0", "name": "Markup/Topic/ReferenceLinks/ReferenceLink", "description": ""}], "subInformationUnits": []}], "constraints": [{"id": "C-DM-02", "businessRuleIds": ["BR-DM-02"], "informationUnitIds": ["IU-INS-041", "IU-INS-042", "IU-INS-05"], "description": "IU-INS-041 is not empty AND IU-INS-042 is not empty", "expressions": []}], "subERs": [], "fullTitle": "Defect inspection form", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER01", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the defect inspection form", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "The inspection finding becomes a BCF topic in the logging step."}], "subErs": []}, {"id": "5619d897-1698-5481-854a-ad111a34116f", "guid": "5619d897-1698-5481-854a-ad111a34116f", "shortTitle": "ER_DefectLogEntry", "name": "Defect log entry (BCF topic)", "description": "The defect as a BCF topic in the project issue register, linked to the coordination model by a viewpoint.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-LOG-01", "name": "Defect", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "A construction defect recorded as one BCF topic.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066341-2a6rri", "text": "Snag", "lang": "en-GB"}, {"id": "syn-1795261066341-a151ay", "text": "Punch list item", "lang": "en-US"}, {"id": "syn-1795261066341-kw9fem", "text": "Nonconformity", "lang": "en"}, {"id": "syn-1795261066341-z31mdx", "text": "하자", "lang": "ko"}, {"id": "syn-1795261066341-epwk88", "text": "不具合", "lang": "ja"}, {"id": "syn-1795261066341-l01t6p", "text": "Mangel", "lang": "de"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-hy7j1f", "basis": "BCF 3.0", "name": "Markup/Topic", "description": "TopicType = Defect"}], "subInformationUnits": [{"id": "IU-LOG-011", "name": "Topic GUID", "dataType": "String / Text", "isMandatory": true, "definition": "Globally unique identifier of the topic.", "definitionFigures": [], "synonyms": [], "examples": "3e1f6b52-0c4a-4d8e-9b71-5a2f8c0d1e01", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-ojowu8", "basis": "BCF 3.0", "name": "Markup/Topic/@Guid", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-012", "name": "Defect number", "dataType": "String / Text", "isMandatory": true, "definition": "Project defect number, assigned by the issue server.", "definitionFigures": [], "synonyms": [], "examples": "DEF-0001", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-w8mqe7", "basis": "BCF 3.0", "name": "Markup/Topic/@ServerAssignedId", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-013", "name": "Title", "dataType": "String / Text", "isMandatory": true, "definition": "Short title of the defect.", "definitionFigures": [], "synonyms": [], "examples": "Fire door D-3F-12 does not self-close", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-shpq5t", "basis": "BCF 3.0", "name": "Markup/Topic/Title", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-014", "name": "Topic type", "dataType": "String / Text", "isMandatory": true, "definition": "Type of the topic; always Defect in this IDM.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-7z6ui2", "basis": "BCF 3.0", "name": "Markup/Topic/@TopicType", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-015", "name": "Status", "dataType": "String / Text", "isMandatory": true, "definition": "Current status of the defect in the defect lifecycle.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066341-n3y6g2", "text": "상태", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-4t8mx9", "basis": "BCF 3.0", "name": "Markup/Topic/@TopicStatus", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-016", "name": "Description", "dataType": "String / Text", "isMandatory": true, "definition": "Description of the defect (from the inspection form).", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-fgc41v", "basis": "BCF 3.0", "name": "Markup/Topic/Description", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-017", "name": "Created on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time at which the topic was created.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-p8kch8", "basis": "BCF 3.0", "name": "Markup/Topic/CreationDate", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-018", "name": "Created by", "dataType": "String / Text", "isMandatory": true, "definition": "User who created the topic.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-krlt0a", "basis": "BCF 3.0", "name": "Markup/Topic/CreationAuthor", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-019", "name": "Labels", "dataType": "String / Text", "isMandatory": false, "definition": "Trade, category, severity and safety labels.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-icps7v", "basis": "BCF 3.0", "name": "Markup/Topic/Labels/Label", "description": ""}], "subInformationUnits": []}]}, {"id": "IU-LOG-02", "name": "Model reference", "dataType": "String / Text", "isMandatory": true, "definition": "IFC model file in which the defect is located.", "definitionFigures": [], "synonyms": [], "examples": "RMOB_ARC_3F_v12.ifc", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-qojq8u", "basis": "BCF 3.0", "name": "Markup/Header/Files/File", "description": "Filename, Date and @IfcProject of the coordination model."}], "subInformationUnits": []}, {"id": "IU-LOG-03", "name": "Viewpoint", "dataType": "3D Model", "isMandatory": true, "definition": "Saved view of the model that shows the defect.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-ks2mzq", "basis": "BCF 3.0", "name": "Markup/Topic/Viewpoints/ViewPoint", "description": ""}], "subInformationUnits": [{"id": "IU-LOG-031", "name": "Camera", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Camera position, direction and field of view.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-r1xx45", "basis": "BCF 3.0", "name": "VisualizationInfo/PerspectiveCamera", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-032", "name": "Selected components", "dataType": "String / Text", "isMandatory": true, "definition": "IFC GlobalIds of the affected elements.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-lk4ewe", "basis": "BCF 3.0", "name": "VisualizationInfo/Components/Selection/Component/@IfcGuid", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-033", "name": "Snapshot", "dataType": "Image", "isMandatory": true, "definition": "Image of the viewpoint (photograph or model view).", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-89qquu", "basis": "BCF 3.0", "name": "Markup/Topic/Viewpoints/ViewPoint/Snapshot", "description": ""}], "subInformationUnits": []}]}, {"id": "IU-LOG-04", "name": "Source inspection form", "dataType": "Document (PDF, DOCX, etc.)", "isMandatory": true, "definition": "Reference to the defect inspection form.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-jdhhe1", "basis": "BCF 3.0", "name": "Markup/Topic/DocumentReferences/DocumentReference", "description": "Document stored in the BCF file (documents.xml)."}], "subInformationUnits": []}, {"id": "IU-LOG-05", "name": "Related defects", "dataType": "String / Text", "isMandatory": false, "definition": "Other topics that describe the same or a recurring defect.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-4c2w6r", "basis": "BCF 3.0", "name": "Markup/Topic/RelatedTopics/RelatedTopic/@Guid", "description": ""}], "subInformationUnits": []}, {"id": "IU-LOG-06", "name": "Construction stage", "dataType": "String / Text", "isMandatory": false, "definition": "Stage of the project in which the defect was found.", "definitionFigures": [], "synonyms": [], "examples": "Fit-out", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-uwkkbp", "basis": "BCF 3.0", "name": "Markup/Topic/Stage", "description": ""}], "subInformationUnits": []}], "constraints": [{"id": "C-DM-01", "businessRuleIds": ["BR-DM-01"], "informationUnitIds": ["IU-LOG-011", "IU-LOG-012"], "description": "IU-LOG-011 is a UUID AND IU-LOG-011 is unique AND IU-LOG-012 is unique within the project", "expressions": [{"id": "expr-1795261066341-n0yqrx", "xmlId": "C-DM-01-py", "language": {"name": "Python", "version": "3", "publicationYear": "", "uri": ""}, "form": "text", "body": "import re\nUUID = re.compile(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')\n\ndef check(topics):\n    \"\"\"topics: list of dicts with 'guid' and 'server_id'. Returns violations.\"\"\"\n    bad = [t['guid'] for t in topics if not UUID.match(t['guid'])]\n    for key in ('guid', 'server_id'):\n        seen = set()\n        for t in topics:\n            if t[key] in seen:\n                bad.append(t[key])\n            seen.add(t[key])\n    return bad  # non-empty = violation", "uri": ""}]}, {"id": "C-DM-03", "businessRuleIds": ["BR-DM-02", "BR-DM-03"], "informationUnitIds": ["IU-LOG-032", "IU-LOG-033"], "description": "The first viewpoint of every defect topic has a snapshot (IU-LOG-033) and at least one selected component (IU-LOG-032) when an element is affected", "expressions": [{"id": "expr-1795261066341-61zqfp", "xmlId": "C-DM-03-sch", "language": {"name": "Schematron", "version": "ISO/IEC 19757-3:2020", "publicationYear": "2020", "uri": "http://purl.oclc.org/dsdl/schematron"}, "form": "xml", "body": "<sch:schema xmlns:sch=\"http://purl.oclc.org/dsdl/schematron\" queryBinding=\"xslt2\">\n              <sch:pattern id=\"bcf-defect-evidence\">\n                <sch:rule context=\"Markup/Topic[@TopicType = 'Defect']\">\n                  <sch:assert test=\"Viewpoints/ViewPoint[1]/Snapshot\">BR-DM-03: defect <sch:value-of select=\"@ServerAssignedId\"/> has no snapshot.</sch:assert>\n                </sch:rule>\n              </sch:pattern>\n            </sch:schema>", "uri": ""}]}, {"id": "C-DM-04", "businessRuleIds": ["BR-DM-04"], "informationUnitIds": ["IU-LOG-014", "IU-LOG-015", "IU-LOG-019"], "description": "IU-LOG-014 = 'Defect' AND IU-LOG-015 IN extensions.xml/TopicStatuses AND every IU-LOG-019 IN extensions.xml/TopicLabels", "expressions": [{"id": "expr-1795261066341-qe680f", "xmlId": "C-DM-04-sch", "language": {"name": "Schematron", "version": "ISO/IEC 19757-3:2020", "publicationYear": "2020", "uri": "http://purl.oclc.org/dsdl/schematron"}, "form": "xml", "body": "<sch:schema xmlns:sch=\"http://purl.oclc.org/dsdl/schematron\" queryBinding=\"xslt2\">\n              <sch:let name=\"ext\" value=\"doc('../extensions.xml')/Extensions\"/>\n              <sch:pattern id=\"bcf-vocabularies\">\n                <sch:rule context=\"Markup/Topic\">\n                  <sch:assert test=\"@TopicType = 'Defect'\">BR-DM-04: topic type shall be Defect.</sch:assert>\n                  <sch:assert test=\"@TopicStatus = $ext/TopicStatuses/TopicStatus\">BR-DM-04: status not in extensions.xml.</sch:assert>\n                  <sch:assert test=\"not(Priority) or Priority = $ext/Priorities/Priority\">BR-DM-04: priority not in extensions.xml.</sch:assert>\n                  <sch:assert test=\"every $l in Labels/Label satisfies $l = $ext/TopicLabels/TopicLabel\">BR-DM-04: label not in extensions.xml.</sch:assert>\n                </sch:rule>\n              </sch:pattern>\n            </sch:schema>", "uri": ""}]}, {"id": "C-DM-05", "businessRuleIds": ["BR-DM-05"], "informationUnitIds": ["IU-LOG-015"], "description": "Each change of IU-LOG-015 is an allowed transition of the defect status lifecycle", "expressions": [{"id": "expr-1795261066341-m85cfl", "xmlId": "C-DM-05-py", "language": {"name": "Python", "version": "3", "publicationYear": "", "uri": ""}, "form": "text", "body": "ALLOWED = {\n    'Open': {'Assigned', 'Rejected'},\n    'Assigned': {'In progress', 'Resolved'},\n    'In progress': {'Resolved'},\n    'Resolved': {'Closed', 'Reopened'},\n    'Reopened': {'Assigned'},\n}\n\ndef check(status_history):\n    \"\"\"status_history: statuses of one topic in time order.\"\"\"\n    return [(a, b) for a, b in zip(status_history, status_history[1:])\n            if b not in ALLOWED.get(a, set())]  # non-empty = violation", "uri": ""}]}], "subERs": [], "fullTitle": "Defect log entry (BCF topic)", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER02", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the defect log entry (bcf topic)", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "One topic per defect: markup.bcf, viewpoint.bcfv and snapshot."}, {"basis": "IFC4.3", "name": "IFC4.3 Reference View", "description": "Coordination model referenced by the BCF header and viewpoints."}], "subErs": []}, {"id": "31aad244-33ac-5f23-81f6-113426f23d96", "guid": "31aad244-33ac-5f23-81f6-113426f23d96", "shortTitle": "ER_TriageRecord", "name": "Triage record", "description": "Decision of the quality manager on validity, severity, priority and category of a logged defect.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-TRI-01", "name": "Triage decision", "dataType": "String / Text", "isMandatory": true, "definition": "Accept as defect, Reject (not a defect) or Duplicate.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-luztjy", "basis": "BCF 3.0", "name": "Markup/Topic/@TopicStatus", "description": "Accept -> Assigned (after assignment); Reject or Duplicate -> Rejected."}], "subInformationUnits": []}, {"id": "IU-TRI-02", "name": "Severity", "dataType": "String / Text", "isMandatory": true, "definition": "Consequence of the defect: Critical, Major, Minor or Cosmetic.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066341-n3xopn", "text": "심각도", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-4mrvry", "basis": "BCF 3.0", "name": "Markup/Topic/Labels/Label", "description": "Label 'Severity: Major' etc."}], "subInformationUnits": []}, {"id": "IU-TRI-03", "name": "Priority", "dataType": "String / Text", "isMandatory": true, "definition": "Urgency of rectification: P1 - Critical, P2 - High, P3 - Medium or P4 - Low.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066341-qu2kkv", "text": "우선순위", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-n4utzz", "basis": "BCF 3.0", "name": "Markup/Topic/Priority", "description": ""}], "subInformationUnits": []}, {"id": "IU-TRI-04", "name": "Defect category", "dataType": "String / Text", "isMandatory": true, "definition": "Workmanship, Material, Damage, Missing work or Safety.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-o95djq", "basis": "BCF 3.0", "name": "Markup/Topic/Labels/Label", "description": "Label 'Category: Workmanship' etc."}], "subInformationUnits": []}, {"id": "IU-TRI-05", "name": "Safety-critical", "dataType": "Boolean", "isMandatory": true, "definition": "True if the defect endangers people.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-bzyjkb", "basis": "BCF 3.0", "name": "Markup/Topic/Labels/Label", "description": "Label 'Safety' when true."}], "subInformationUnits": []}, {"id": "IU-TRI-06", "name": "Duplicate of", "dataType": "String / Text", "isMandatory": false, "definition": "Defect number of the original defect, if this is a duplicate.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-waxdow", "basis": "BCF 3.0", "name": "Markup/Topic/RelatedTopics/RelatedTopic/@Guid", "description": ""}], "subInformationUnits": []}, {"id": "IU-TRI-07", "name": "Triage comment", "dataType": "Structured (list, graph, table, JSON)", "isMandatory": true, "definition": "Comment that records the triage.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-c9yr92", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment", "description": ""}], "subInformationUnits": [{"id": "IU-TRI-071", "name": "Triaged on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time of the triage.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-gv42s8", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Date", "description": ""}], "subInformationUnits": []}, {"id": "IU-TRI-072", "name": "Triaged by", "dataType": "String / Text", "isMandatory": true, "definition": "Quality manager who triaged the defect.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-80zmji", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Author", "description": ""}], "subInformationUnits": []}, {"id": "IU-TRI-073", "name": "Rationale", "dataType": "String / Text", "isMandatory": true, "definition": "Reason for the decision and the classification.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-hzfoih", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Comment", "description": ""}], "subInformationUnits": []}]}, {"id": "IU-TRI-08", "name": "Root cause (preliminary)", "dataType": "String / Text", "isMandatory": false, "definition": "Not exchanged in BCF; kept in the quality management system.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}], "constraints": [{"id": "C-DM-06", "businessRuleIds": ["BR-DM-06"], "informationUnitIds": ["IU-LOG-017", "IU-TRI-071"], "description": "working_days(IU-LOG-017, IU-TRI-071) <= 2", "expressions": [{"id": "expr-1795261066341-fuom3w", "xmlId": "C-DM-06-py", "language": {"name": "Python", "version": "3", "publicationYear": "", "uri": ""}, "form": "text", "body": "import numpy as np\n\ndef check(created_on, triaged_on, holidays=()):\n    days = np.busday_count(created_on.date(), triaged_on.date(), holidays=list(holidays))\n    return days > 2  # True = violation", "uri": ""}]}, {"id": "C-DM-08", "businessRuleIds": ["BR-DM-08"], "informationUnitIds": ["IU-TRI-05", "IU-TRI-03"], "description": "IU-TRI-05 = true IMPLIES IU-TRI-03 = 'P1 - Critical'", "expressions": [{"id": "expr-1795261066341-dwdni4", "xmlId": "C-DM-08-shacl", "language": {"name": "SHACL", "version": "", "publicationYear": "2017", "uri": "http://www.w3.org/ns/shacl#"}, "form": "text", "body": "@prefix sh:  <http://www.w3.org/ns/shacl#> .\n@prefix bcf: <https://example.org/bcf#> .\n\nbcf:SafetyCriticalDefectShape a sh:NodeShape ;\n  sh:targetClass bcf:Topic ;\n  sh:or (\n    [ sh:path bcf:label ; sh:not [ sh:hasValue \"Safety\" ] ]\n    [ sh:path bcf:priority ; sh:hasValue \"P1 - Critical\" ]\n  ) ;\n  sh:message \"BR-DM-08: a safety-critical defect shall have priority P1 - Critical\" .", "uri": ""}]}], "subERs": [], "fullTitle": "Triage record", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER03", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the triage record", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "Triage updates the topic and adds a triage comment."}], "subErs": []}, {"id": "a4642088-e79b-5489-9e28-695bc45c760b", "guid": "a4642088-e79b-5489-9e28-695bc45c760b", "shortTitle": "ER_AssignmentNotice", "name": "Defect assignment notice", "description": "Instruction from the general contractor to the responsible trade subcontractor to rectify a defect by a due date.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-ASG-01", "name": "Notice number", "dataType": "String / Text", "isMandatory": true, "definition": "Number of the assignment notice.", "definitionFigures": [], "synonyms": [], "examples": "DAN-2026-0141", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-ASG-02", "name": "Responsible party", "dataType": "String / Text", "isMandatory": true, "definition": "Organization responsible for the rectification.", "definitionFigures": [], "synonyms": [], "examples": "Sample Doors & Hardware Ltd.", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-ASG-03", "name": "Assignee", "dataType": "String / Text", "isMandatory": true, "definition": "Person of the responsible party who rectifies the defect.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066341-f2wfun", "text": "담당자", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-blimyz", "basis": "BCF 3.0", "name": "Markup/Topic/AssignedTo", "description": "E-mail address of a user in extensions.xml."}], "subInformationUnits": []}, {"id": "IU-ASG-04", "name": "Due date", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time by which the defect shall be rectified.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066341-sz5pbv", "text": "조치 기한", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-lec1id", "basis": "BCF 3.0", "name": "Markup/Topic/DueDate", "description": ""}], "subInformationUnits": []}, {"id": "IU-ASG-05", "name": "Required action", "dataType": "String / Text", "isMandatory": true, "definition": "What the assignee shall do.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-5cu7u0", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Comment", "description": ""}], "subInformationUnits": []}, {"id": "IU-ASG-06", "name": "Issued on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time of the assignment.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066341-5uzczb", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Date", "description": ""}], "subInformationUnits": []}, {"id": "IU-ASG-07", "name": "Back-charge applicable", "dataType": "Boolean", "isMandatory": false, "definition": "True if the cost of rectification is charged to the responsible party.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}], "constraints": [{"id": "C-DM-07", "businessRuleIds": ["BR-DM-07"], "informationUnitIds": ["IU-TRI-03", "IU-TRI-071", "IU-ASG-04"], "description": "IU-ASG-04 - IU-TRI-071 <= 1 d (P1), 7 d (P2), 14 d (P3), 30 d (P4) according to IU-TRI-03", "expressions": [{"id": "expr-1795261066341-oqqnf0", "xmlId": "C-DM-07-py", "language": {"name": "Python", "version": "3", "publicationYear": "", "uri": ""}, "form": "text", "body": "from datetime import timedelta\nLIMIT = {'P1 - Critical': 1, 'P2 - High': 7, 'P3 - Medium': 14, 'P4 - Low': 30}\n\ndef check(priority, triaged_on, due_date):\n    return due_date - triaged_on > timedelta(days=LIMIT[priority])  # True = violation", "uri": ""}, {"id": "expr-1795261066341-me0qiq", "xmlId": "C-DM-07-sparql", "language": {"name": "SPARQL", "version": "1.1", "publicationYear": "2013", "uri": ""}, "form": "text", "body": "PREFIX bcf: <https://example.org/bcf#>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nASK {  # true = violation\n  ?t a bcf:Topic ; bcf:topicType \"Defect\" ; bcf:priority ?p ; bcf:dueDate ?due ; bcf:triagedOn ?tri .\n  VALUES (?p ?days) { (\"P1 - Critical\" 1) (\"P2 - High\" 7) (\"P3 - Medium\" 14) (\"P4 - Low\" 30) }\n  FILTER ( (xsd:date(?due) - xsd:date(?tri)) > xsd:dayTimeDuration(CONCAT(\"P\", STR(?days), \"D\")) )\n}", "uri": ""}]}, {"id": "C-DM-09", "businessRuleIds": ["BR-DM-09"], "informationUnitIds": ["IU-ASG-03", "IU-ASG-02"], "description": "count(IU-ASG-03) = 1 AND IU-ASG-03 IN extensions.xml/Users AND IU-ASG-03 belongs to IU-ASG-02", "expressions": [{"id": "expr-1795261066341-qb7i19", "xmlId": "C-DM-09-sch", "language": {"name": "Schematron", "version": "ISO/IEC 19757-3:2020", "publicationYear": "2020", "uri": "http://purl.oclc.org/dsdl/schematron"}, "form": "xml", "body": "<sch:schema xmlns:sch=\"http://purl.oclc.org/dsdl/schematron\" queryBinding=\"xslt2\">\n              <sch:let name=\"users\" value=\"doc('../extensions.xml')/Extensions/Users/User\"/>\n              <sch:pattern id=\"bcf-assignee\">\n                <sch:rule context=\"Markup/Topic[@TopicStatus = ('Assigned', 'In progress', 'Resolved', 'Reopened')]\">\n                  <sch:assert test=\"count(AssignedTo) = 1\">BR-DM-09: exactly one assignee.</sch:assert>\n                  <sch:assert test=\"AssignedTo = $users\">BR-DM-09: assignee is not a project user.</sch:assert>\n                </sch:rule>\n              </sch:pattern>\n            </sch:schema>", "uri": ""}]}], "subERs": [], "fullTitle": "Defect assignment notice", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER04", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the defect assignment notice", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "Assignment sets AssignedTo and DueDate of the topic."}], "subErs": []}, {"id": "4efac59c-6677-552d-ae4d-30be580cf160", "guid": "4efac59c-6677-552d-ae4d-30be580cf160", "shortTitle": "ER_RectificationReport", "name": "Rectification report", "description": "Report of the trade subcontractor that the defect has been rectified, with evidence.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-RES-01", "name": "Rectification description", "dataType": "String / Text", "isMandatory": true, "definition": "What was done to rectify the defect.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-scbsyu", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Comment", "description": ""}], "subInformationUnits": []}, {"id": "IU-RES-02", "name": "Completed on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time of completion.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-almluw", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Date", "description": ""}], "subInformationUnits": []}, {"id": "IU-RES-03", "name": "Completed by", "dataType": "String / Text", "isMandatory": true, "definition": "Assignee who reports the rectification.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-vtez13", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Author", "description": ""}], "subInformationUnits": []}, {"id": "IU-RES-04", "name": "After photograph", "dataType": "Image", "isMandatory": true, "definition": "Photograph of the rectified work.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-rgjbz8", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Viewpoint/@Guid", "description": "Viewpoint whose snapshot is the photograph."}], "subInformationUnits": []}, {"id": "IU-RES-05", "name": "Cause found", "dataType": "String / Text", "isMandatory": false, "definition": "Cause of the defect found during rectification.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}, {"id": "IU-RES-06", "name": "Requested status", "dataType": "String / Text", "isMandatory": true, "definition": "Status requested by the assignee; Resolved.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-nu23wa", "basis": "BCF 3.0", "name": "Markup/Topic/@TopicStatus", "description": ""}], "subInformationUnits": []}], "constraints": [{"id": "C-DM-10", "businessRuleIds": ["BR-DM-10"], "informationUnitIds": ["IU-RES-01", "IU-RES-04", "IU-RES-06"], "description": "IU-RES-06 = 'Resolved' IMPLIES IU-RES-01 is not empty AND IU-RES-04 is not empty", "expressions": []}], "subERs": [], "fullTitle": "Rectification report", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER05", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the rectification report", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "Added to the topic as a comment with a viewpoint."}], "subErs": []}, {"id": "1e5828b3-f59e-50b1-83d7-0ed2aab21955", "guid": "1e5828b3-f59e-50b1-83d7-0ed2aab21955", "shortTitle": "ER_VerificationRecord", "name": "Verification record", "description": "Result of the re-inspection of a rectified defect by the site quality inspector.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-VER-01", "name": "Verified on", "dataType": "Date / Time", "isMandatory": true, "definition": "Date and time of the re-inspection.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-u80wgh", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Date", "description": ""}], "subInformationUnits": []}, {"id": "IU-VER-02", "name": "Verified by", "dataType": "String / Text", "isMandatory": true, "definition": "Inspector who verified the rectification.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-fd9pha", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Author", "description": ""}], "subInformationUnits": []}, {"id": "IU-VER-03", "name": "Verification result", "dataType": "String / Text", "isMandatory": true, "definition": "Passed or Failed.", "definitionFigures": [], "synonyms": [{"id": "syn-1795261066342-685dsh", "text": "확인 결과", "lang": "ko"}], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-hwfp3g", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Comment", "description": "Comment text starts with 'Verification: Passed' or 'Verification: Failed'."}], "subInformationUnits": []}, {"id": "IU-VER-04", "name": "Remarks", "dataType": "String / Text", "isMandatory": false, "definition": "Reason for a failed verification or other remarks.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-k20x2g", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Comment", "description": ""}], "subInformationUnits": []}, {"id": "IU-VER-05", "name": "Verification photograph", "dataType": "Image", "isMandatory": false, "definition": "Photograph taken during verification.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [{"id": "CEE-1795261066342-eh4zps", "basis": "BCF 3.0", "name": "Markup/Topic/Comments/Comment/Viewpoint/@Guid", "description": ""}], "subInformationUnits": []}, {"id": "IU-VER-06", "name": "Failed verifications", "dataType": "Numeric", "isMandatory": true, "definition": "Number of failed verifications of this defect so far.", "definitionFigures": [], "synonyms": [], "examples": "", "exampleImages": [], "correspondingExternalElements": [], "subInformationUnits": []}], "constraints": [{"id": "C-DM-13", "businessRuleIds": ["BR-DM-13"], "informationUnitIds": ["IU-VER-06"], "description": "IU-VER-06 > 2 IMPLIES escalation to the project manager", "expressions": []}], "subERs": [], "fullTitle": "Verification record", "version": "1.0", "idmCode": "IDM-KR-DMBCF-01-ER06", "subTitle": "", "documentStatus": "WD", "localCode": "", "localDocumentStatus": "", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Exchange requirement drafted from the verification record", "changedBy": "author-1", "changes": []}], "correspondingEvds": [{"basis": "BCF 3.0", "name": "BIM Collaboration Format topics", "description": "Added to the topic as a comment; the status becomes Closed-ready or Reopened."}], "subErs": []}, {"id": "1824a928-4180-5eac-a5ae-de918b5bb2ec", "guid": "1824a928-4180-5eac-a5ae-de918b5bb2ec", "shortTitle": "ER_ClosureRecord", "name": "Defect closure record", "description": "Formal closure of the defect by the BIM coordinator after a passed verification.", "descriptionFigures": [], "examples": "", "exampleImages": [], "informationUnits": [{"id": "IU-CLO-01", "name": "Final status", "dataType": "String / Text", "isMandatory": true, "definition": "Closed (or Rejected for defects rejected at triage).", "definitionFigu
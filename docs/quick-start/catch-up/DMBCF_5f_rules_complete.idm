{"version": "2.0.0", "format": "idm-binary", "appName": "xPPM neo-Seoul", "bpmnXml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_DMBCF\" targetNamespace=\"https://big.yonsei.ac.kr/idm/samples\" exporter=\"BIG sample generator\" exporterVersion=\"1.0\">\n  <bpmn:collaboration id=\"Collaboration_DMBCF\">\n    <bpmn:participant id=\"Participant_GC\" name=\"General contractor\" processRef=\"Process_GC\" />\n    <bpmn:participant id=\"Participant_Sub\" name=\"Trade subcontractor\" processRef=\"Process_Sub\" />\n    <bpmn:participant id=\"Participant_Owner\" name=\"Owner&#39;s representative\" processRef=\"Process_Owner\" />\n    <bpmn:messageFlow id=\"MessageFlow_Assignment\" name=\"Defect assignment notice\" sourceRef=\"Task_Assign\" targetRef=\"Start_Sub\" />\n    <bpmn:messageFlow id=\"MessageFlow_Rectified\" name=\"Rectification report\" sourceRef=\"End_Sub\" targetRef=\"Catch_Rectified\" />\n    <bpmn:messageFlow id=\"MessageFlow_Report\" name=\"Defect status report\" sourceRef=\"Task_Report\" targetRef=\"Start_Owner\" />\n  </bpmn:collaboration>\n  <bpmn:process id=\"Process_GC\" isExecutable=\"false\">\n    <bpmn:laneSet id=\"LaneSet_GC\">\n      <bpmn:lane id=\"Lane_QualityInspector\" name=\"Site quality inspector\">\n        <bpmn:flowNodeRef>Start_Inspection</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>Task_Identify</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>DataObject_Inspection</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>Catch_Rectified</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>Task_Verify</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>DataObject_Verification</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>Gateway_Accepted</bpmn:flowNodeRef>\n      </bpmn:lane>\n      <bpmn:lane id=\"Lane_BIMCoordinator\" name=\"BIM coordinator\">\n        <bpmn:flowNodeRef>Task_Log</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>DataObject_Topic</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>Task_Close</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>DataObject_Closure</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>End_Closed</bpmn:flowNodeRef>\n      </bpmn:lane>\n      <bpmn:lane id=\"Lane_QualityManager\" name=\"Quality manager\">\n        <bpmn:flowNodeRef>Task_Triage</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>DataObject_Triage</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>Gateway_Valid</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>Task_Assign</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>DataObject_Assignment</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>Start_Daily</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>DataObject_StatusReport</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>End_Report</bpmn:flowNodeRef>\n      </bpmn:lane>\n    </bpmn:laneSet>\n    <bpmn:startEvent id=\"Start_Inspection\" name=\"Site inspection started\">\n      <bpmn:outgoing>Flow_01</bpmn:outgoing>\n    </bpmn:startEvent>\n    <bpmn:task id=\"Task_Identify\" name=\"1 Identify defect\">\n      <bpmn:incoming>Flow_01</bpmn:incoming>\n      <bpmn:outgoing>Flow_02</bpmn:outgoing>\n      <bpmn:dataOutputAssociation id=\"DOA_01\">\n        <bpmn:targetRef>DataObject_Inspection</bpmn:targetRef>\n      </bpmn:dataOutputAssociation>\n    </bpmn:task>\n    <bpmn:dataObject id=\"DataObject_Inspection_obj\" />\n    <bpmn:dataObjectReference id=\"DataObject_Inspection\" name=\"Defect inspection form\" dataObjectRef=\"DataObject_Inspection_obj\" />\n    <bpmn:task id=\"Task_Log\" name=\"2 Log defect as BCF topic\">\n      <bpmn:incoming>Flow_02</bpmn:incoming>\n      <bpmn:outgoing>Flow_03</bpmn:outgoing>\n      <bpmn:property id=\"Property_DIA_02\" name=\"__targetRef_placeholder\" />\n      <bpmn:dataInputAssociation id=\"DIA_02\">\n        <bpmn:sourceRef>DataObject_Inspection</bpmn:sourceRef>\n        <bpmn:targetRef>Property_DIA_02</bpmn:targetRef>\n      </bpmn:dataInputAssociation>\n      <bpmn:dataOutputAssociation id=\"DOA_02\">\n        <bpmn:targetRef>DataObject_Topic</bpmn:targetRef>\n      </bpmn:dataOutputAssociation>\n    </bpmn:task>\n    <bpmn:dataObject id=\"DataObject_Topic_obj\" />\n    <bpmn:dataObjectReference id=\"DataObject_Topic\" name=\"Defect log entry (BCF topic)\" dataObjectRef=\"DataObject_Topic_obj\" />\n    <bpmn:task id=\"Task_Triage\" name=\"3 Triage defect\">\n      <bpmn:incoming>Flow_03</bpmn:incoming>\n      <bpmn:outgoing>Flow_04</bpmn:outgoing>\n      <bpmn:dataOutputAssociation id=\"DOA_03\">\n        <bpmn:targetRef>DataObject_Triage</bpmn:targetRef>\n      </bpmn:dataOutputAssociation>\n    </bpmn:task>\n    <bpmn:dataObject id=\"DataObject_Triage_obj\" />\n    <bpmn:dataObjectReference id=\"DataObject_Triage\" name=\"Triage record\" dataObjectRef=\"DataObject_Triage_obj\" />\n    <bpmn:exclusiveGateway id=\"Gateway_Valid\" name=\"Valid defect?\">\n      <bpmn:incoming>Flow_04</bpmn:incoming>\n      <bpmn:outgoing>Flow_05</bpmn:outgoing>\n      <bpmn:outgoing>Flow_06</bpmn:outgoing>\n    </bpmn:exclusiveGateway>\n    <bpmn:endEvent id=\"End_Rejected\" name=\"Defect rejected\">\n      <bpmn:incoming>Flow_06</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:task id=\"Task_Assign\" name=\"4 Assign defect to responsible party\">\n      <bpmn:incoming>Flow_05</bpmn:incoming>\n      <bpmn:incoming>Flow_11</bpmn:incoming>\n      <bpmn:outgoing>Flow_07</bpmn:outgoing>\n      <bpmn:dataOutputAssociation id=\"DOA_04\">\n        <bpmn:targetRef>DataObject_Assignment</bpmn:targetRef>\n      </bpmn:dataOutputAssociation>\n    </bpmn:task>\n    <bpmn:dataObject id=\"DataObject_Assignment_obj\" />\n    <bpmn:dataObjectReference id=\"DataObject_Assignment\" name=\"Defect assignment notice\" dataObjectRef=\"DataObject_Assignment_obj\" />\n    <bpmn:intermediateCatchEvent id=\"Catch_Rectified\" name=\"Rectification reported\">\n      <bpmn:incoming>Flow_07</bpmn:incoming>\n      <bpmn:outgoing>Flow_08</bpmn:outgoing>\n      <bpmn:messageEventDefinition id=\"MED_Rectified\" />\n    </bpmn:intermediateCatchEvent>\n    <bpmn:task id=\"Task_Verify\" name=\"6 Verify rectification\">\n      <bpmn:incoming>Flow_08</bpmn:incoming>\n      <bpmn:outgoing>Flow_09</bpmn:outgoing>\n      <bpmn:dataOutputAssociation id=\"DOA_06\">\n        <bpmn:targetRef>DataObject_Verification</bpmn:targetRef>\n      </bpmn:dataOutputAssociation>\n    </bpmn:task>\n    <bpmn:dataObject id=\"DataObject_Verification_obj\" />\n    <bpmn:dataObjectReference id=\"DataObject_Verification\" name=\"Verification record\" dataObjectRef=\"DataObject_Verification_obj\" />\n    <bpmn:exclusiveGateway id=\"Gateway_Accepted\" name=\"Rectification accepted?\">\n      <bpmn:incoming>Flow_09</bpmn:incoming>\n      <bpmn:outgoing>Flow_10</bpmn:outgoing>\n      <bpmn:outgoing>Flow_11</bpmn:outgoing>\n    </bpmn:exclusiveGateway>\n    <bpmn:task id=\"Task_Close\" name=\"7 Close defect\">\n      <bpmn:incoming>Flow_10</bpmn:incoming>\n      <bpmn:outgoing>Flow_12</bpmn:outgoing>\n      <bpmn:dataOutputAssociation id=\"DOA_07\">\n        <bpmn:targetRef>DataObject_Closure</bpmn:targetRef>\n      </bpmn:dataOutputAssociation>\n    </bpmn:task>\n    <bpmn:dataObject id=\"DataObject_Closure_obj\" />\n    <bpmn:dataObjectReference id=\"DataObject_Closure\" name=\"Defect closure record\" dataObjectRef=\"DataObject_Closure_obj\" />\n    <bpmn:endEvent id=\"End_Closed\" name=\"Defect closed\">\n      <bpmn:incoming>Flow_12</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:startEvent id=\"Start_Daily\" name=\"Every day 17:00\">\n      <bpmn:outgoing>Flow_13</bpmn:outgoing>\n      <bpmn:timerEventDefinition id=\"TED_Daily\" />\n    </bpmn:startEvent>\n    <bpmn:task id=\"Task_Report\" name=\"Report and analyse defects\">\n      <bpmn:incoming>Flow_13</bpmn:incoming>\n      <bpmn:outgoing>Flow_14</bpmn:outgoing>\n      <bpmn:dataOutputAssociation id=\"DOA_08\">\n        <bpmn:targetRef>DataObject_StatusReport</bpmn:targetRef>\n      </bpmn:dataOutputAssociation>\n    </bpmn:task>\n    <bpmn:dataObject id=\"DataObject_StatusReport_obj\" />\n    <bpmn:dataObjectReference id=\"DataObject_StatusReport\" name=\"Defect status report\" dataObjectRef=\"DataObject_StatusReport_obj\" />\n    <bpmn:endEvent id=\"End_Report\" name=\"Report issued\">\n      <bpmn:incoming>Flow_14</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:sequenceFlow id=\"Flow_01\" sourceRef=\"Start_Inspection\" targetRef=\"Task_Identify\" />\n    <bpmn:sequenceFlow id=\"Flow_02\" sourceRef=\"Task_Identify\" targetRef=\"Task_Log\" />\n    <bpmn:sequenceFlow id=\"Flow_03\" sourceRef=\"Task_Log\" targetRef=\"Task_Triage\" />\n    <bpmn:sequenceFlow id=\"Flow_04\" sourceRef=\"Task_Triage\" targetRef=\"Gateway_Valid\" />\n    <bpmn:sequenceFlow id=\"Flow_05\" name=\"Yes\" sourceRef=\"Gateway_Valid\" targetRef=\"Task_Assign\" />\n    <bpmn:sequenceFlow id=\"Flow_06\" name=\"No\" sourceRef=\"Gateway_Valid\" targetRef=\"End_Rejected\" />\n    <bpmn:sequenceFlow id=\"Flow_07\" sourceRef=\"Task_Assign\" targetRef=\"Catch_Rectified\" />\n    <bpmn:sequenceFlow id=\"Flow_08\" sourceRef=\"Catch_Rectified\" targetRef=\"Task_Verify\" />\n    <bpmn:sequenceFlow id=\"Flow_09\" sourceRef=\"Task_Verify\" targetRef=\"Gateway_Accepted\" />\n    <bpmn:sequenceFlow id=\"Flow_10\" name=\"Yes\" sourceRef=\"Gateway_Accepted\" targetRef=\"Task_Close\" />\n    <bpmn:sequenceFlow id=\"Flow_11\" name=\"No - reopen\" sourceRef=\"Gateway_Accepted\" targetRef=\"Task_Assign\" />\n    <bpmn:sequenceFlow id=\"Flow_12\" sourceRef=\"Task_Close\" targetRef=\"End_Closed\" />\n    <bpmn:sequenceFlow id=\"Flow_13\" sourceRef=\"Start_Daily\" targetRef=\"Task_Report\" />\n    <bpmn:sequenceFlow id=\"Flow_14\" sourceRef=\"Task_Report\" targetRef=\"End_Report\" />\n  </bpmn:process>\n  <bpmn:process id=\"Process_Sub\" isExecutable=\"false\">\n    <bpmn:startEvent id=\"Start_Sub\" name=\"Assignment received\">\n      <bpmn:outgoing>Flow_S1</bpmn:outgoing>\n      <bpmn:messageEventDefinition id=\"MED_Assignment\" />\n    </bpmn:startEvent>\n    <bpmn:task id=\"Task_Rectify\" name=\"5 Rectify defect and report\">\n      <bpmn:incoming>Flow_S1</bpmn:incoming>\n      <bpmn:outgoing>Flow_S2</bpmn:outgoing>\n      <bpmn:dataOutputAssociation id=\"DOA_05\">\n        <bpmn:targetRef>DataObject_Rectification</bpmn:targetRef>\n      </bpmn:dataOutputAssociation>\n    </bpmn:task>\n    <bpmn:dataObject id=\"DataObject_Rectification_obj\" />\n    <bpmn:dataObjectReference id=\"DataObject_Rectification\" name=\"Rectification report\" dataObjectRef=\"DataObject_Rectification_obj\" />\n    <bpmn:endEvent id=\"End_Sub\" name=\"Rectification reported\">\n      <bpmn:incoming>Flow_S2</bpmn:incoming>\n      <bpmn:messageEventDefinition id=\"MED_Reported\" />\n    </bpmn:endEvent>\n    <bpmn:sequenceFlow id=\"Flow_S1\" sourceRef=\"Start_Sub\" targetRef=\"Task_Rectify\" />\n    <bpmn:sequenceFlow id=\"Flow_S2\" sourceRef=\"Task_Rectify\" targetRef=\"End_Sub\" />\n  </bpmn:process>\n  <bpmn:process id=\"Process_Owner\" isExecutable=\"false\">\n    <bpmn:startEvent id=\"Start_Owner\" name=\"Report received\">\n      <bpmn:outgoing>Flow_O1</bpmn:outgoing>\n      <bpmn:messageEventDefinition id=\"MED_Report\" />\n    </bpmn:startEvent>\n    <bpmn:task id=\"Task_Review\" name=\"Review defect status and trends\">\n      <bpmn:incoming>Flow_O1</bpmn:incoming>\n      <bpmn:outgoing>Flow_O2</bpmn:outgoing>\n    </bpmn:task>\n    <bpmn:endEvent id=\"End_Owner\" name=\"Review completed\">\n      <bpmn:incoming>Flow_O2</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:sequenceFlow id=\"Flow_O1\" sourceRef=\"Start_Owner\" targetRef=\"Task_Review\" />\n    <bpmn:sequenceFlow id=\"Flow_O2\" sourceRef=\"Task_Review\" targetRef=\"End_Owner\" />\n  </bpmn:process>\n  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\">\n    <bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_DMBCF\">\n      <bpmndi:BPMNShape id=\"Participant_GC_di\" bpmnElement=\"Participant_GC\" isHorizontal=\"true\">\n        <dc:Bounds x=\"0\" y=\"0\" width=\"1760\" height=\"520\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Lane_QualityManager_di\" bpmnElement=\"Lane_QualityManager\" isHorizontal=\"true\">\n        <dc:Bounds x=\"30\" y=\"320\" width=\"1730\" height=\"200\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Lane_BIMCoordinator_di\" bpmnElement=\"Lane_BIMCoordinator\" isHorizontal=\"true\">\n        <dc:Bounds x=\"30\" y=\"160\" width=\"1730\" height=\"160\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Lane_QualityInspector_di\" bpmnElement=\"Lane_QualityInspector\" isHorizontal=\"true\">\n        <dc:Bounds x=\"30\" y=\"0\" width=\"1730\" height=\"160\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Start_Inspection_di\" bpmnElement=\"Start_Inspection\">\n        <dc:Bounds x=\"92\" y=\"62\" width=\"36\" height=\"36\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Task_Identify_di\" bpmnElement=\"Task_Identify\">\n        <dc:Bounds x=\"160\" y=\"45\" width=\"110\" height=\"70\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"DataObject_Inspection_di\" bpmnElement=\"DataObject_Inspection\">\n        <dc:Bounds x=\"292\" y=\"100\" width=\"36\" height=\"50\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"332\" y=\"112\" width=\"90\" height=\"27\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Task_Log_di\" bpmnElement=\"Task_Log\">\n        <dc:Bounds x=\"330\" y=\"205\" width=\"110\" height=\"70\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"DataObject_Topic_di\" bpmnElement=\"DataObject_Topic\">\n        <dc:Bounds x=\"462\" y=\"256\" width=\"36\" height=\"50\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"502\" y=\"268\" width=\"100\" height=\"27\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Task_Triage_di\" bpmnElement=\"Task_Triage\">\n        <dc:Bounds x=\"490\" y=\"345\" width=\"110\" height=\"70\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"DataObject_Triage_di\" bpmnElement=\"DataObject_Triage\">\n        <dc:Bounds x=\"527\" y=\"440\" width=\"36\" height=\"50\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"567\" y=\"458\" width=\"70\" height=\"14\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Gateway_Valid_di\" bpmnElement=\"Gateway_Valid\" isMarkerVisible=\"true\">\n        <dc:Bounds x=\"645\" y=\"355\" width=\"50\" height=\"50\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"637\" y=\"333\" width=\"66\" height=\"14\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"End_Rejected_di\" bpmnElement=\"End_Rejected\">\n        <dc:Bounds x=\"652\" y=\"460\" width=\"36\" height=\"36\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Task_Assign_di\" bpmnElement=\"Task_Assign\">\n        <dc:Bounds x=\"760\" y=\"345\" width=\"110\" height=\"70\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"DataObject_Assignment_di\" bpmnElement=\"DataObject_Assignment\">\n        <dc:Bounds x=\"892\" y=\"440\" width=\"36\" height=\"50\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"932\" y=\"452\" width=\"90\" height=\"27\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Catch_Rectified_di\" bpmnElement=\"Catch_Rectified\">\n        <dc:Bounds x=\"1080\" y=\"62\" width=\"36\" height=\"36\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"1008\" y=\"104\" width=\"66\" height=\"27\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Task_Verify_di\" bpmnElement=\"Task_Verify\">\n        <dc:Bounds x=\"1160\" y=\"45\" width=\"110\" height=\"70\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"DataObject_Verification_di\" bpmnElement=\"DataObject_Verification\">\n        <dc:Bounds x=\"1290\" y=\"102\" width=\"36\" height=\"50\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"1180\" y=\"124\" width=\"100\" height=\"14\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Gateway_Accepted_di\" bpmnElement=\"Gateway_Accepted\" isMarkerVisible=\"true\">\n        <dc:Bounds x=\"1345\" y=\"55\" width=\"50\" height=\"50\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"1400\" y=\"38\" width=\"70\" height=\"27\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Task_Close_di\" bpmnElement=\"Task_Close\">\n        <dc:Bounds x=\"1450\" y=\"205\" width=\"110\" height=\"70\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"DataObject_Closure_di\" bpmnElement=\"DataObject_Closure\">\n        <dc:Bounds x=\"1582\" y=\"258\" width=\"36\" height=\"50\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"1552\" y=\"309\" width=\"110\" height=\"14\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"End_Closed_di\" bpmnElement=\"End_Closed\">\n        <dc:Bounds x=\"1682\" y=\"222\" width=\"36\" height=\"36\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Start_Daily_di\" bpmnElement=\"Start_Daily\">\n        <dc:Bounds x=\"1222\" y=\"352\" width=\"36\" height=\"36\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"Task_Report_di\" bpmnElement=\"Task_Report\">\n        <dc:Bounds x=\"1300\" y=\"345\" width=\"110\" height=\"70\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"DataObject_StatusReport_di\" bpmnElement=\"DataObject_StatusReport\">\n        <dc:Bounds x=\"1432\" y=\"440\" width=\"36\" height=\"50\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"1472\" y=\"452\" width=\"80\" height=\"27\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNShape id=\"End_Report_di\" bpmnElement=\"End_Report\">\n        <dc:Bounds x=\"1482\" y=\"362\" width=\"36\" height=\"36\" />\n      </bpmndi:BPMNShape>\n      <bpmndi:BPMNEdge id=\"Flow_01_di\" bpmnElement=\"Flow_01\">\n        <di:waypoint x=\"128\" y=\"80\" />\n        <di:waypoint x=\"160\" y=\"80\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_02_di\" bpmnElement=\"Flow_02\">\n        <di:waypoint x=\"215\" y=\"115\" />\n        <di:waypoint x=\"215\" y=\"240\" />\n        <di:waypoint x=\"330\" y=\"240\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_03_di\" bpmnElement=\"Flow_03\">\n        <di:waypoint x=\"385\" y=\"275\" />\n        <di:waypoint x=\"385\" y=\"380\" />\n        <di:waypoint x=\"490\" y=\"380\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_04_di\" bpmnElement=\"Flow_04\">\n        <di:waypoint x=\"600\" y=\"380\" />\n        <di:waypoint x=\"645\" y=\"380\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_05_di\" bpmnElement=\"Flow_05\">\n        <di:waypoint x=\"695\" y=\"380\" />\n        <di:waypoint x=\"760\" y=\"380\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"712\" y=\"360\" width=\"20\" height=\"14\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_06_di\" bpmnElement=\"Flow_06\">\n        <di:waypoint x=\"670\" y=\"405\" />\n        <di:waypoint x=\"670\" y=\"460\" />\n        <bpmndi:BPMNLabel>\n          <dc:Bounds x=\"678\" y=\"425\" width=\"16\" height=\"14\" />\n        </bpmndi:BPMNLabel>\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_07_di\" bpmnElement=\"Flow_07\">\n        <di:waypoint x=\"870\" y=\"380\" />\n        <di:waypoint x=\"1000\" y=\"380\" />\n        <di:waypoint x=\"1000\" y=\"80\" />\n        <di:waypoint x=\"1080\" y=\"80\" />\n      </bpmndi:BPMNEdge>\n      <bpmndi:BPMNEdge id=\"Flow_08_di\" bp
{"version": "2.0.0", "format": "idm-binary", "appName": "xPPM neo-Seoul", "bpmnXml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_DMBCF\" targetNamespace=\"https://big.yonsei.ac.kr/idm/samples\">\n  <bpmn:collaboration id=\"Collaboration_DMBCF\">\n    <bpmn:participant id=\"Participant_GC\" name=\"General contractor\" processRef=\"Process_GC\"/>\n    <bpmn:participant id=\"Participant_Sub\" name=\"Trade subcontractor\" processRef=\"Process_Sub\"/>\n    <bpmn:participant id=\"Participant_Owner\" name=\"Owner's representative\" processRef=\"Process_Owner\"/>\n  </bpmn:collaboration>\n  <bpmn:process id=\"Process_GC\" isExecutable=\"false\">\n    <bpmn:laneSet id=\"LaneSet_GC\">\n      <bpmn:lane id=\"Lane_QualityInspector\" name=\"Site quality inspector\"><bpmn:flowNodeRef>Start_Inspection</bpmn:flowNodeRef></bpmn:lane>\n      <bpmn:lane id=\"Lane_BIMCoordinator\" name=\"BIM coordinator\"></bpmn:lane>\n      <bpmn:lane id=\"Lane_QualityManager\" name=\"Quality manager\"></bpmn:lane>\n    </bpmn:laneSet>\n    <bpmn:startEvent id=\"Start_Inspection\" name=\"Site inspection started\"/>\n  </bpmn:process>\n  <bpmn:process id=\"Process_Sub\" isExecutable=\"false\">\n  </bpmn:process>\n  <bpmn:process id=\"Process_Owner\" isExecutable=\"false\">\n  </bpmn:process>\n  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\"><bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_DMBCF\">\n    <bpmndi:BPMNShape id=\"Participant_GC_di\" bpmnElement=\"Participant_GC\" isHorizontal=\"true\"><dc:Bounds x=\"0\" y=\"0\" width=\"1760\" height=\"520\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Participant_Sub_di\" bpmnElement=\"Participant_Sub\" isHorizontal=\"true\"><dc:Bounds x=\"0\" y=\"550\" width=\"1760\" height=\"160\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Participant_Owner_di\" bpmnElement=\"Participant_Owner\" isHorizontal=\"true\"><dc:Bounds x=\"0\" y=\"740\" width=\"1760\" height=\"160\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Lane_QualityInspector_di\" bpmnElement=\"Lane_QualityInspector\" isHorizontal=\"true\"><dc:Bounds x=\"30\" y=\"0\" width=\"1730\" height=\"160\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Lane_BIMCoordinator_di\" bpmnElement=\"Lane_BIMCoordinator\" isHorizontal=\"true\"><dc:Bounds x=\"30\" y=\"160\" width=\"1730\" height=\"160\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Lane_QualityManager_di\" bpmnElement=\"Lane_QualityManager\" isHorizontal=\"true\"><dc:Bounds x=\"30\" y=\"320\" width=\"1730\" height=\"200\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Start_Inspection_di\" bpmnElement=\"Start_Inspection\"><dc:Bounds x=\"92\" y=\"62\" width=\"36\" height=\"36\"/></bpmndi:BPMNShape>\n  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>\n</bpmn:definitions>", "erHierarchy": [], "dataObjectErMap": {}, "erDataMap": {}, "erLibrary": [], "headerData": {"title": "Defect Management Using BCF", "authors": [{"type": "person", "id": "author-1", "givenName": "Ghang", "familyName": "Lee", "middleInitial": "", "affiliation": "Yonsei University", "uri": "glee@yonsei.ac.kr", "prefix": "", "suffix": "", "postnominalDesignation": "", "affiliationOrgIds": [], "isLead": true, "affiliationOrgId": ""}, {"type": "organization", "id": "author-2", "name": "Building Informatics Group (BIG), Yonsei University", "uri": ""}], "organization": "", "version": "1.0", "creationDate": "", "status": "WD", "language": "EN", "region": "KR", "projectStages": ["production"], "useCategories": ["Construction Quality Management", "Issue Management"], "summary": "The general contractor identifies construction defects on site, logs each defect as a BIM Collaboration Format (BCF) topic linked to the building model, triages and assigns it to the responsible trade subcontractor, verifies the rectification and closes the topic. A daily defect status report summarises the BCF topics for the owner's representative.", "revisionHistory": [{"date": "2026-11-20", "description": "Tutorial sample created: process map, eight ERs from the defect management forms, BCF 3.0 mappings, 14 business rules and constraints"}], "contributors": [], "copyright": "Copyright 2026 Building Informatics Group (BIG), Yonsei University. Tutorial sample; fictitious project data; not normative.", "keywords": ["defect management", "BCF", "quality control", "punch list", "issue tracking"], "relatedStandards": [], "externalReferences": [], "objectives": "Aim: replace paper punch lists and spreadsheet defect logs with BCF topics that carry location, photographs, status and responsibility, so that every party works on the same defect record.", "benefits": "One defect record from identification to closure; defects located in the model; measurable response times; fewer disputes about responsibility.", "limitations": "BCF does not define defect-specific fields such as severity or root cause; they are carried as labels or comments by project convention (see the BCF extensions of the project).", "actors": "", "preconditions": "", "postconditions": "", "triggeringEvents": "", "requiredCapabilities": "", "complianceCriteria": "", "actorsList": [{"id": "actor-gc", "name": "General contractor", "external": false, "bpmnShapeName": "Participant_GC", "role": "", "subActors": [{"id": "actor-gc-qi", "name": "Site quality inspector", "role": "", "bpmnShapeName": "Lane_QualityInspector"}, {"id": "actor-gc-bim", "name": "BIM coordinator", "role": "", "bpmnShapeName": "Lane_BIMCoordinator"}, {"id": "actor-gc-qm", "name": "Quality manager", "role": "", "bpmnShapeName": "Lane_QualityManager"}], "bpmnId": "Participant_GC"}, {"id": "actor-sub", "name": "Trade subcontractor", "external": false, "bpmnShapeName": "Participant_Sub", "role": "", "subActors": [], "bpmnId": "Participant_Sub"}, {"id": "actor-own", "name": "Owner's representative", "external": true, "bpmnShapeName": "Participant_Owner", "role": "", "subActors": [], "bpmnId": "Participant_Owner"}], "shortTitle": "DMBCF", "subTitle": "Identification, logging, triage, assignment, resolution, verification and closure of construction defects, with reporting and analysis (tutorial sample)", "localShortTitle": "하자관리", "changeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Tutorial sample created: process map, eight ERs from the defect management forms, BCF 3.0 mappings, 14 business rules and constraints", "changedBy": "author-1", "changes": []}], "publisher": {"name": "Building Informatics Group (BIG), Yonsei University", "location": "Seoul, Republic of Korea"}, "idmCode": "IDM-KR-DMBCF-01", "idmGuid": "afbf4728-82f8-53f9-b57a-e48bc3523bc1", "localDocumentStatus": "", "localCode": "", "idmXsdVersion": "2.0", "idmXsdVersionConfidence": "high", "aimAndScope": "Aim: replace paper punch lists and spreadsheet defect logs with BCF topics that carry location, photographs, status and responsibility, so that every party works on the same defect record.", "uses": [{"verb": "Construction", "noun": "Quality Management"}, {"verb": "Issue", "noun": "Management"}], "useClassification": null, "regions": ["KR"], "projectStagesIso": ["production"], "projectStagesAia": [], "projectStagesRiba": [], "customProjectPhases": [{"id": "custom-phase-1", "classificationName": "Korean construction project phases (건설사업 단계)", "phaseName": "Construction (시공)"}], "benefitKeywords": ["traceability", "response time"], "references": "[basis] ISO 29481-1:2025 Building information models - Information delivery manual - Part 1: Methodology and format\nbuildingSMART International, BIM Collaboration Format (BCF) 3.0, BCF-XML\nISO 19650-2:2018 Organization and digitization of information about buildings and civil engineering works, including BIM - Information management using building information modelling - Part 2: Delivery phase of the assets\nISO 9001:2015 Quality management systems - Requirements, 10.2 Nonconformity and corrective action", "requiredResources": "BCF 3.0 capable issue management tool or common data environment (CDE); IFC 4.3 coordination model; mobile device with camera for site inspection.", "requiredCompetencies": "Site inspection and quality control; use of a BCF viewer; knowledge of the project quality plan.", "constructionEntities": ["Office building", "Healthcare facility"], "additionalDescription": "Sample status = Tutorial sample for xPPM neo-Seoul. Project, companies, people and regulatory references are fictitious or illustrative.", "ucGuid": "df6a2294-7003-564e-858d-042ce4d4aca4", "ucShortTitle": "DMBCF_UC", "ucFullTitle": "Defect Management Using BCF - Use case", "ucIdmCode": "IDM-KR-DMBCF-01-UC", "ucSubTitle": "", "ucDocumentStatus": "WD", "ucVersion": "1.0", "ucLocalCode": "", "ucLocalDocumentStatus": "", "ucChangeLogs": [{"id": "log-1", "changeDateTime": "2026-11-20T10:00:00", "changeSummary": "Use case drafted", "changedBy": "author-1", "changes": []}], "summaryFigures": [], "aimAndScopeFigures": [], "benefitsFigures": [], "limitationsFigures": [], "businessRules": []}, "exportedAt": "2026-11-20T10:00:00.000Z"}
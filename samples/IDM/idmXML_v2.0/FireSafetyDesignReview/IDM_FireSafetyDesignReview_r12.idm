{
  "version": "2.0.0",
  "appName": "xPPM neo-Seoul",
  "bpmnXml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_FSDR\" targetNamespace=\"https://big.yonsei.ac.kr/idm/samples\" exporter=\"BIG sample generator\" exporterVersion=\"1.0\">\n  <bpmn:collaboration id=\"Collaboration_FSDR\">\n    <bpmn:participant id=\"Participant_Architect\" name=\"Architect\" processRef=\"Process_Architect\"/>\n    <bpmn:participant id=\"Participant_FireEngineer\" name=\"Fire safety engineer\" processRef=\"Process_FireEngineer\"/>\n    <bpmn:participant id=\"Participant_Authority\" name=\"Building permit authority\" processRef=\"Process_Authority\"/>\n    <bpmn:messageFlow id=\"MessageFlow_Model\" name=\"Fire safety design model\" sourceRef=\"Task_ExportModel\" targetRef=\"Start_FSE\"/>\n    <bpmn:messageFlow id=\"MessageFlow_Report\" name=\"Fire safety review report\" sourceRef=\"Task_IssueReport\" targetRef=\"Start_Authority\"/>\n  </bpmn:collaboration>\n  <bpmn:process id=\"Process_Architect\" isExecutable=\"false\">\n    <bpmn:laneSet id=\"LS_Process_Architect\">\n      <bpmn:lane id=\"Lane_DesignArchitect\" name=\"Design architect\">\n        <bpmn:flowNodeRef>Start_FSDR</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>Task_DefineCompartments</bpmn:flowNodeRef>\n      </bpmn:lane>\n      <bpmn:lane id=\"Lane_BIMCoordinator\" name=\"BIM coordinator\">\n        <bpmn:flowNodeRef>Task_ExportModel</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>DataObject_FireSafetyModel</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>End_Architect</bpmn:flowNodeRef>\n      </bpmn:lane>\n    </bpmn:laneSet>\n    <bpmn:startEvent id=\"Start_FSDR\" name=\"Design development started\">\n      <bpmn:outgoing>Flow_A1</bpmn:outgoing>\n    </bpmn:startEvent>\n    <bpmn:task id=\"Task_DefineCompartments\" name=\"Define fire compartments and egress\">\n      <bpmn:incoming>Flow_A1</bpmn:incoming>\n      <bpmn:outgoing>Flow_A2</bpmn:outgoing>\n    </bpmn:task>\n    <bpmn:task id=\"Task_ExportModel\" name=\"Export fire safety design model\">\n      <bpmn:incoming>Flow_A2</bpmn:incoming>\n      <bpmn:outgoing>Flow_A3</bpmn:outgoing>\n      <bpmn:dataOutputAssociation id=\"Assoc_A1\"><bpmn:targetRef>DataObject_FireSafetyModel</bpmn:targetRef></bpmn:dataOutputAssociation>\n    </bpmn:task>\n    <bpmn:dataObject id=\"DataObject_FireSafetyModel_obj\"/>\n    <bpmn:dataObjectReference id=\"DataObject_FireSafetyModel\" name=\"Fire safety design model\" dataObjectRef=\"DataObject_FireSafetyModel_obj\"/>\n    <bpmn:endEvent id=\"End_Architect\" name=\"Model submitted\">\n      <bpmn:incoming>Flow_A3</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:sequenceFlow id=\"Flow_A1\" sourceRef=\"Start_FSDR\" targetRef=\"Task_DefineCompartments\"/>\n    <bpmn:sequenceFlow id=\"Flow_A2\" sourceRef=\"Task_DefineCompartments\" targetRef=\"Task_ExportModel\"/>\n    <bpmn:sequenceFlow id=\"Flow_A3\" sourceRef=\"Task_ExportModel\" targetRef=\"End_Architect\"/>\n  </bpmn:process>\n  <bpmn:process id=\"Process_FireEngineer\" isExecutable=\"false\">\n    <bpmn:startEvent id=\"Start_FSE\" name=\"Model received\">\n      <bpmn:outgoing>Flow_F1</bpmn:outgoing>\n    </bpmn:startEvent>\n    <bpmn:task id=\"Task_CheckModel\" name=\"Check compartments, ratings and travel distances\">\n      <bpmn:incoming>Flow_F1</bpmn:incoming>\n      <bpmn:outgoing>Flow_F2</bpmn:outgoing>\n    </bpmn:task>\n    <bpmn:task id=\"Task_IssueReport\" name=\"Issue fire safety review report\">\n      <bpmn:incoming>Flow_F2</bpmn:incoming>\n      <bpmn:outgoing>Flow_F3</bpmn:outgoing>\n    </bpmn:task>\n    <bpmn:endEvent id=\"End_FSE\" name=\"Report issued\">\n      <bpmn:incoming>Flow_F3</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:sequenceFlow id=\"Flow_F1\" sourceRef=\"Start_FSE\" targetRef=\"Task_CheckModel\"/>\n    <bpmn:sequenceFlow id=\"Flow_F2\" sourceRef=\"Task_CheckModel\" targetRef=\"Task_IssueReport\"/>\n    <bpmn:sequenceFlow id=\"Flow_F3\" sourceRef=\"Task_IssueReport\" targetRef=\"End_FSE\"/>\n  </bpmn:process>\n  <bpmn:process id=\"Process_Authority\" isExecutable=\"false\">\n    <bpmn:laneSet id=\"LS_Process_Authority\">\n      <bpmn:lane id=\"Lane_FirePlanReviewer\" name=\"Fire plan reviewer\">\n        <bpmn:flowNodeRef>Start_Authority</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>Task_ReviewPermit</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>End_Authority</bpmn:flowNodeRef>\n      </bpmn:lane>\n    </bpmn:laneSet>\n    <bpmn:startEvent id=\"Start_Authority\" name=\"Report received\">\n      <bpmn:outgoing>Flow_R1</bpmn:outgoing>\n    </bpmn:startEvent>\n    <bpmn:task id=\"Task_ReviewPermit\" name=\"Review fire safety documents for permit\">\n      <bpmn:incoming>Flow_R1</bpmn:incoming>\n      <bpmn:outgoing>Flow_R2</bpmn:outgoing>\n    </bpmn:task>\n    <bpmn:endEvent id=\"End_Authority\" name=\"Review completed\">\n      <bpmn:incoming>Flow_R2</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:sequenceFlow id=\"Flow_R1\" sourceRef=\"Start_Authority\" targetRef=\"Task_ReviewPermit\"/>\n    <bpmn:sequenceFlow id=\"Flow_R2\" sourceRef=\"Task_ReviewPermit\" targetRef=\"End_Authority\"/>\n  </bpmn:process>\n  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\"><bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_FSDR\">\n    <bpmndi:BPMNShape id=\"Participant_Architect_di\" bpmnElement=\"Participant_Architect\" isHorizontal=\"true\"><dc:Bounds x=\"0\" y=\"0\" width=\"900\" height=\"300\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Lane_DesignArchitect_di\" bpmnElement=\"Lane_DesignArchitect\" isHorizontal=\"true\"><dc:Bounds x=\"30\" y=\"0\" width=\"870\" height=\"150\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Lane_BIMCoordinator_di\" bpmnElement=\"Lane_BIMCoordinator\" isHorizontal=\"true\"><dc:Bounds x=\"30\" y=\"150\" width=\"870\" height=\"150\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Start_FSDR_di\" bpmnElement=\"Start_FSDR\"><dc:Bounds x=\"82\" y=\"57\" width=\"36\" height=\"36\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Task_DefineCompartments_di\" bpmnElement=\"Task_DefineCompartments\"><dc:Bounds x=\"175\" y=\"40\" width=\"110\" height=\"70\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Task_ExportModel_di\" bpmnElement=\"Task_ExportModel\"><dc:Bounds x=\"345\" y=\"190\" width=\"110\" height=\"70\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"DataObject_FireSafetyModel_di\" bpmnElement=\"DataObject_FireSafetyModel\"><dc:Bounds x=\"542\" y=\"200\" width=\"36\" height=\"50\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"End_Architect_di\" bpmnElement=\"End_Architect\"><dc:Bounds x=\"682\" y=\"207\" width=\"36\" height=\"36\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNEdge id=\"Flow_A1_di\" bpmnElement=\"Flow_A1\"><di:waypoint x=\"118\" y=\"75\"/><di:waypoint x=\"175\" y=\"75\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNEdge id=\"Flow_A2_di\" bpmnElement=\"Flow_A2\"><di:waypoint x=\"285\" y=\"75\"/><di:waypoint x=\"315\" y=\"75\"/><di:waypoint x=\"315\" y=\"225\"/><di:waypoint x=\"345\" y=\"225\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNEdge id=\"Flow_A3_di\" bpmnElement=\"Flow_A3\"><di:waypoint x=\"455\" y=\"225\"/><di:waypoint x=\"682\" y=\"225\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNShape id=\"Participant_FireEngineer_di\" bpmnElement=\"Participant_FireEngineer\" isHorizontal=\"true\"><dc:Bounds x=\"0\" y=\"330\" width=\"900\" height=\"150\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Start_FSE_di\" bpmnElement=\"Start_FSE\"><dc:Bounds x=\"282\" y=\"387\" width=\"36\" height=\"36\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Task_CheckModel_di\" bpmnElement=\"Task_CheckModel\"><dc:Bounds x=\"375\" y=\"370\" width=\"110\" height=\"70\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Task_IssueReport_di\" bpmnElement=\"Task_IssueReport\"><dc:Bounds x=\"545\" y=\"370\" width=\"110\" height=\"70\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"End_FSE_di\" bpmnElement=\"End_FSE\"><dc:Bounds x=\"742\" y=\"387\" width=\"36\" height=\"36\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNEdge id=\"Flow_F1_di\" bpmnElement=\"Flow_F1\"><di:waypoint x=\"318\" y=\"405\"/><di:waypoint x=\"375\" y=\"405\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNEdge id=\"Flow_F2_di\" bpmnElement=\"Flow_F2\"><di:waypoint x=\"485\" y=\"405\"/><di:waypoint x=\"545\" y=\"405\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNEdge id=\"Flow_F3_di\" bpmnElement=\"Flow_F3\"><di:waypoint x=\"655\" y=\"405\"/><di:waypoint x=\"742\" y=\"405\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNShape id=\"Participant_Authority_di\" bpmnElement=\"Participant_Authority\" isHorizontal=\"true\"><dc:Bounds x=\"0\" y=\"510\" width=\"900\" height=\"150\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Lane_FirePlanReviewer_di\" bpmnElement=\"Lane_FirePlanReviewer\" isHorizontal=\"true\"><dc:Bounds x=\"30\" y=\"510\" width=\"870\" height=\"150\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Start_Authority_di\" bpmnElement=\"Start_Authority\"><dc:Bounds x=\"582\" y=\"567\" width=\"36\" height=\"36\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Task_ReviewPermit_di\" bpmnElement=\"Task_ReviewPermit\"><dc:Bounds x=\"675\" y=\"550\" width=\"110\" height=\"70\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"End_Authority_di\" bpmnElement=\"End_Authority\"><dc:Bounds x=\"842\" y=\"567\" width=\"36\" height=\"36\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNEdge id=\"Flow_R1_di\" bpmnElement=\"Flow_R1\"><di:waypoint x=\"618\" y=\"585\"/><di:waypoint x=\"675\" y=\"585\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNEdge id=\"Flow_R2_di\" bpmnElement=\"Flow_R2\"><di:waypoint x=\"785\" y=\"585\"/><di:waypoint x=\"842\" y=\"585\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNEdge id=\"Assoc_A1_di\" bpmnElement=\"Assoc_A1\"><di:waypoint x=\"400\" y=\"260\"/><di:waypoint x=\"560\" y=\"200\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNEdge id=\"MessageFlow_Model_di\" bpmnElement=\"MessageFlow_Model\"><di:waypoint x=\"400\" y=\"260\"/><di:waypoint x=\"400\" y=\"323.5\"/><di:waypoint x=\"300\" y=\"323.5\"/><di:waypoint x=\"300\" y=\"387\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNEdge id=\"MessageFlow_Report_di\" bpmnElement=\"MessageFlow_Report\"><di:waypoint x=\"600\" y=\"440\"/><di:waypoint x=\"600\" y=\"567\"/></bpmndi:BPMNEdge>\n  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>\n</bpmn:definitions>",

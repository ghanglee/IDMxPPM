              "body": "<Implies xmlns=\"http://ruleml.org/spec\">\n              <if>\n                <Atom>\n                  <Rel>nonConformity</Rel>\n                  <Var>n</Var>\n                </Atom>\n              </if>\n              <then>\n                <And>\n                  <Atom>\n                    <Rel>hasViolatedRule</Rel>\n                    <Var>n</Var>\n                    <Var>r</Var>\n                  </Atom>\n                  <Atom>\n                    <Rel>hasAffectedElement</Rel>\n                    <Var>n</Var>\n                    <Var>g</Var>\n                  </Atom>\n                </And>\n              </then>\n            </Implies>",

          "shortTitle": "ER_Egress",
          "name": "Egress",
          "description": "Egress paths from habitable rooms to direct stairs.",
          "descriptionFigures": [],
          "examples": "",
          "exampleImages": [],
          "informationUnits": [
            {
              "id": "IU-05",
              "name": "Egress path",
              "dataType": "IfcRelSpaceBoundary",
              "isMandatory": true,
              "definition": "The egress path is measured along the actual walking route, not as a straight line.",
              "definitionFigures": [

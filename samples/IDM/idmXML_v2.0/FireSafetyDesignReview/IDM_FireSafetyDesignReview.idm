    "businessRules": [
      {
        "id": "BR-FS-01",
        "name": "Fire compartment assignment",
        "statement": "Every space shall be assigned to exactly one fire compartment.",
        "images": [],
        "commentary": [
          {
            "id": "c-1792022287970-mddfkq",
            "text": "Commentary: shafts and stair enclosures form their own compartments."
          }
        ],
        "reference": ""
      },
      {
        "id": "BR-FS-02",
        "name": "Fire compartment area limit",
        "statement": "The floor area of a fire compartment shall not exceed 1,000 m2, or 3,000 m2 where an automatic sprinkler system is installed.",
        "images": [
          {
            "id": "fig-1792022287970-mnoaay",
            "name": "Fire compartment plan with floor areas",
            "caption": "Fire compartment plan with floor areas",
            "type": "image/png",
            "data": "data:image/png;base64,"
          }
        ],
        "commentary": [
          {
            "id": "c-1792022287970-1taia1",
            "text": "Commentary: the limit applies per storey; check the decree for exemptions by use."
          }
        ],
        "reference": "Enforcement Decree of the Building Act (Republic of Korea), Art. 46 (illustrative)"
      },
      {
        "id": "BR-FS-03",
        "name": "Fire resistance of compartment boundaries",
        "statement": "Walls and slabs that bound a fire compartment shall have a fire resistance of at least 1 hour.",
        "images": [],
        "commentary": [],
        "reference": "EN 13501-2 (classification of fire resistance)"
      },
      {
        "id": "BR-FS-04",
        "name": "Fire doors in compartment boundaries",
        "statement": "Every door in a fire compartment boundary shall be a self-closing fire door.",
        "images": [],
        "commentary": [],
        "reference": ""
      },
      {
        "id": "BR-FS-05",
        "name": "Travel distance to direct stair",
        "statement": "The walking distance from any point in a habitable room to the nearest direct stair shall not exceed 30 m, or 50 m where the main structural parts are fire-resistant.",
        "images": [],
        "commentary": [
          {
            "id": "c-1792022287970-oq46pk",
            "text": "Commentary: measured along the actual walking path, not as a straight line."
          }
        ],
        "reference": "Enforcement Decree of the Building Act (Republic of Korea), Art. 34 (illustrative)"
      },
      {
        "id": "BR-FS-06",
        "name": "Exit door clear width",
        "statement": "The clear width of every exit door on an egress path shall be at least 0.9 m.",
        "images": [],
        "commentary": [],
        "reference": ""
      },
      {
        "id": "BR-FS-07",
        "name": "Traceable non-conformities",
        "statement": "Every non-conformity in the fire safety review report shall identify the violated business rule and the affected building element.",
        "images": [],
        "commentary": [
          {
            "id": "c-1792022287970-7unc2k",
            "text": "Commentary: non-conformities are exchanged as BCF topics so that the architect can locate them in the model."
          }
        ],
        "reference": "buildingSMART BIM Collaboration Format (BCF) 3.0"
      }
    ],

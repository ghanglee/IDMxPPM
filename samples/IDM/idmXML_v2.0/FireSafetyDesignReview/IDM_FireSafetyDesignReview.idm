  "erHierarchy": [
    {
      "id": "3f6c2a1e-8b4d-4e7a-9c15-000000000010",
      "guid": "3f6c2a1e-8b4d-4e7a-9c15-000000000010",
      "shortTitle": "ER_FireSafetyDesignReview",
      "name": "Fire safety design review information",
      "description": "Exchange requirements of the fire safety design review: the design model delivered by the architect (with three sub-ERs) and the review report issued by the fire safety engineer.",
      "descriptionFigures": [],
      "examples": "",
      "exampleImages": [],
      "informationUnits": [],
      "constraints": [],
      "subERs": [
        {
          "id": "3f6c2a1e-8b4d-4e7a-9c15-000000000004",
          "guid": "3f6c2a1e-8b4d-4e7a-9c15-000000000004",
          "shortTitle": "ER_FireSafetyDesignModel",
          "name": "Fire safety design model",
          "description": "Information the architect delivers for fire safety design review at design development.",
          "descriptionFigures": [],
          "examples": "",
          "exampleImages": [],
          "informationUnits": [],
          "constraints": [
            {
              "id": "C-01",
              "businessRuleIds": [
                "BR-FS-01"
              ],
              "informationUnitIds": [
                "IU-01",
                "IU-013"
              ],
              "description": "IU-013 references exactly one IU-02 for every IU-01",
              "expressions": []
            },
            {
              "id": "C-02",
              "businessRuleIds": [
                "BR-FS-02"
              ],
              "informationUnitIds": [
                "IU-022",
                "IU-023"
              ],
              "description": "IU-022 <= 1000 m2 WHERE IU-023 = false; IU-022 <= 3000 m2 WHERE IU-023 = true",
              "expressions": [
                {
                  "id": "expr-1792022287973-labwdn",
                  "xmlId": "C-02-sparql",
                  "language": {
                    "name": "SPARQL",
                    "version": "1.1",
                    "publicationYear": "2013",
                    "uri": ""
                  },
                  "form": "text",
                  "body": "PREFIX ifc: <https://standards.buildingsmart.org/IFC/DEV/IFC4_3/OWL#>\nASK {  # true = violation\n  ?z a ifc:IfcZone ; ifc:objectType \"FireCompartment\" ; :grossFloorArea ?a ; :isSprinklered ?s .\n  FILTER ( (?s = false && ?a > 1000) || (?s = true && ?a > 3000) )\n}",
                  "uri": ""
                }
              ]
            },
            {
              "id": "C-03",
              "businessRuleIds": [
                "BR-FS-03"
              ],
              "informationUnitIds": [
                "IU-031"
              ],
              "description": "IU-031 >= 60 min",
              "expressions": [
                {
                  "id": "expr-1792022287973-o78kiu",
                  "xmlId": "C-03-legalruleml",
                  "language": {
                    "name": "LegalRuleML",
                    "version": "1.0",
                    "publicationYear": "2021",
                    "uri": "http://docs.oasis-open.org/legalruleml/ns/v1.0/"
                  },
                  "form": "xml",
                  "body": "<lrml:LegalRuleML xmlns:lrml=\"http://docs.oasis-open.org/legalruleml/ns/v1.0/\" xmlns:ruleml=\"http://ruleml.org/spec\">\n              <lrml:Statements key=\"fs03\">\n                <lrml:PrescriptiveStatement key=\"ps-fs03\">\n                  <ruleml:Rule closure=\"universal\">\n                    <ruleml:if>\n                      <ruleml:Atom>\n                        <ruleml:Rel>boundsFireCompartment</ruleml:Rel>\n                        <ruleml:Var>e</ruleml:Var>\n                      </ruleml:Atom>\n                    </ruleml:if>\n                    <ruleml:then>\n                      <lrml:Obligation>\n                        <ruleml:Atom>\n                          <ruleml:Rel>fireResistanceAtLeast</ruleml:Rel>\n                          <ruleml:Var>e</ruleml:Var>\n                          <ruleml:Data>PT60M</ruleml:Data>\n                        </ruleml:Atom>\n                      </lrml:Obligation>\n                    </ruleml:then>\n                  </ruleml:Rule>\n                </lrml:PrescriptiveStatement>\n              </lrml:Statements>\n            </lrml:LegalRuleML>",
                  "uri": ""
                }
              ]
            },
            {
              "id": "C-04",
              "businessRuleIds": [
                "BR-FS-04"
              ],
              "informationUnitIds": [
                "IU-041",
                "IU-042"
              ],
              "description": "IU-041 is not empty AND IU-042 = true",
              "expressions": []
            },
            {
              "id": "C-05",
              "businessRuleIds": [
                "BR-FS-05"
              ],
              "informationUnitIds": [
                "IU-051"
              ],
              "description": "IU-051 <= 30 m, or <= 50 m for fire-resistant structures",
              "expressions": [
                {
                  "id": "expr-1792022287973-rwjpru",
                  "xmlId": "C-05-python",
                  "language": {
                    "name": "Python",
                    "version": "3",
                    "publicationYear": "",
                    "uri": ""
                  },
                  "form": "text",
                  "body": "def check(egress_paths, fire_resistant_structure):\n    limit = 50.0 if fire_resistant_structure else 30.0\n    return [p.id for p in egress_paths if p.travel_distance > limit]  # non-empty = violation",
                  "uri": ""
                },
                {
                  "id": "expr-1792022287973-byi6bw",
                  "xmlId": "C-05-shacl",
                  "language": {
                    "name": "SHACL",
                    "version": "",
                    "publicationYear": "2017",
                    "uri": "http://www.w3.org/ns/shacl#"
                  },
                  "form": "external",
                  "body": "",
                  "uri": "rules/BR-FS-05.shacl.ttl"
                }
              ]
            },
            {
              "id": "C-06",
              "businessRuleIds": [
                "BR-FS-06"
              ],
              "informationUnitIds": [
                "IU-043"
              ],
              "description": "IU-043 >= 0.9 m for doors on an egress path",
              "expressions": []
            }
          ],

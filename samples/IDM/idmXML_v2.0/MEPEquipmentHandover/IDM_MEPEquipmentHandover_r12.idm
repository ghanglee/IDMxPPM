      "constraints": [
        {
          "id": "C-01",
          "businessRuleIds": [
            "BR-HO-01"
          ],
          "informationUnitIds": [
            "IU-041"
          ],
          "description": "IU-041 matches ^[A-Z0-9]+-[A-Z]+-[A-Z]+-[0-9]{3}$ AND is unique",
          "expressions": [
            {
              "id": "expr-1791976131364-ba6wlx",
              "xmlId": "C-01-sparql",
              "language": {
                "name": "SPARQL",
                "version": "1.1",
                "publicationYear": "2013",
                "uri": ""
              },
              "form": "text",
              "body": "ASK {  # true = violation (format or duplicate)\n  { ?c :assetTag ?t . FILTER (!REGEX(?t, \"^[A-Z0-9]+-[A-Z]+-[A-Z]+-[0-9]{3}$\")) }\n  UNION\n  { ?c1 :assetTag ?t . ?c2 :assetTag ?t . FILTER (?c1 != ?c2) }\n}",
              "uri": ""
            }
          ]
        },
        {
          "id": "C-02",
          "businessRuleIds": [
            "BR-HO-02"
          ],
          "informationUnitIds": [
            "IU-031",
            "IU-032"
          ],
          "description": "IU-031 and IU-032 are not empty",
          "expressions": []
        },
        {
          "id": "C-03",
          "businessRuleIds": [
            "BR-HO-03"
          ],
          "informationUnitIds": [
            "IU-042"
          ],
          "description": "IU-042 is not empty",
          "expressions": []
        },
        {
          "id": "C-04",
          "businessRuleIds": [
            "BR-HO-04"
          ],
          "informationUnitIds": [
            "IU-043",
            "IU-021"
          ],
          "description": "IU-043 references exactly one IU-021",
          "expressions": []
        },
        {
          "id": "C-05",
          "businessRuleIds": [
            "BR-HO-05"
          ],
          "informationUnitIds": [
            "IU-044",
            "IU-011"
          ],
          "description": "IU-044 = IU-011",
          "expressions": []
        },
        {
          "id": "C-06",
          "businessRuleIds": [
            "BR-HO-06"
          ],
          "informationUnitIds": [
            "IU-033",
            "IU-034"
          ],
          "description": "IU-034 = 'month' AND IU-033 >= 12",
          "expressions": []
        },
        {
          "id": "C-07",
          "businessRuleIds": [
            "BR-HO-07"
          ],
          "informationUnitIds": [
            "IU-05",
            "IU-052"
          ],
          "description": "count(IU-05 per equipment type WHERE IU-052 > 0) >= 1",
          "expressions": []
        }
      ],

    "businessRules": [
      {
        "id": "BR-HO-01",
        "name": "Asset tag format and uniqueness",
        "statement": "Every equipment asset tag shall follow the pattern Building-System-Type-Sequence (e.g. B01-HVAC-AHU-001) and shall be unique within the facility.",
        "images": [
          {
            "id": "fig-1791976131363-i563dp",
            "name": "images/BR-HO-01_tag_label.png",
            "caption": "Asset tag label on an air handling unit",
            "type": "image/png",
            "filePath": "images/BR-HO-01_tag_label.png"
          }
        ],
        "commentary": [
          {
            "id": "c-1791976131363-p5d28r",
            "text": "Commentary: the sequence number has three digits and restarts for each equipment type."
          }
        ],
        "reference": ""
      },
      {
        "id": "BR-HO-02",
        "name": "Mandatory manufacturer data",
        "statement": "Manufacturer and model number shall be provided for every equipment type.",
        "images": [],
        "commentary": [],
        "reference": ""
      },
      {
        "id": "BR-HO-03",
        "name": "Serial number for components",
        "statement": "A serial number shall be provided for every installed equipment component.",
        "images": [],
        "commentary": [],
        "reference": ""
      },
      {
        "id": "BR-HO-04",
        "name": "Spatial location",
        "statement": "Every equipment component shall be located in exactly one space.",
        "images": [],
        "commentary": [
          {
            "id": "c-1791976131363-psx2j3",
            "text": "Commentary: roof-mounted equipment is assigned to the roof space."
          }
        ],
        "reference": ""
      },
      {
        "id": "BR-HO-05",
        "name": "Warranty start date",
        "statement": "The warranty start date shall equal the date of substantial completion unless the contract states otherwise.",
        "images": [],
        "commentary": [],
        "reference": ""
      },
      {
        "id": "BR-HO-06",
        "name": "Minimum warranty duration",
        "statement": "Warranty duration shall be expressed in months and shall be at least 12 months.",
        "images": [],
        "commentary": [],
        "reference": "Owner's Exchange Information Requirements (EIR), clause 7.3 (illustrative)"
      },
      {
        "id": "BR-HO-07",
        "name": "Planned maintenance task",
        "statement": "Every equipment type shall have at least one planned maintenance task with a frequency greater than zero.",
        "images": [],
        "commentary": [],
        "reference": "ISO 19650-3:2020, 5.6 (illustrative)"
      }
    ],

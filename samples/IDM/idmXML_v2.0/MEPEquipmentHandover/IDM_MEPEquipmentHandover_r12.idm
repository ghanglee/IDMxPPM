{
  "version": "2.0.0",
  "appName": "xPPM neo-Seoul",
  "bpmnXml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:bpmndi=\"http://www.omg.org/spec/BPMN/20100524/DI\" xmlns:dc=\"http://www.omg.org/spec/DD/20100524/DC\" xmlns:di=\"http://www.omg.org/spec/DD/20100524/DI\" id=\"Definitions_MEPH\" targetNamespace=\"https://big.yonsei.ac.kr/idm/samples\" exporter=\"BIG sample generator\" exporterVersion=\"1.0\">\n  <bpmn:collaboration id=\"Collaboration_MEPH\">\n    <bpmn:participant id=\"Participant_Contractor\" name=\"MEP contractor\" processRef=\"Process_Contractor\"/>\n    <bpmn:participant id=\"Participant_Owner\" name=\"Owner / facility manager\" processRef=\"Process_Owner\"/>\n    <bpmn:messageFlow id=\"MessageFlow_Package\" name=\"MEP asset handover package\" sourceRef=\"Task_Compile\" targetRef=\"Start_Owner\"/>\n  </bpmn:collaboration>\n  <bpmn:process id=\"Process_Contractor\" isExecutable=\"false\">\n    <bpmn:laneSet id=\"LS_Process_Contractor\">\n      <bpmn:lane id=\"Lane_Commissioning\" name=\"Commissioning manager\">\n        <bpmn:flowNodeRef>Start_MEPH</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>Task_Commission</bpmn:flowNodeRef>\n      </bpmn:lane>\n      <bpmn:lane id=\"Lane_InfoManager\" name=\"Information manager\">\n        <bpmn:flowNodeRef>Task_Compile</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>DataObject_HandoverPackage</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>End_Contractor</bpmn:flowNodeRef>\n      </bpmn:lane>\n    </bpmn:laneSet>\n    <bpmn:startEvent id=\"Start_MEPH\" name=\"Substantial completion\">\n      <bpmn:outgoing>Flow_C1</bpmn:outgoing>\n    </bpmn:startEvent>\n    <bpmn:task id=\"Task_Commission\" name=\"Commission and tag equipment\">\n      <bpmn:incoming>Flow_C1</bpmn:incoming>\n      <bpmn:outgoing>Flow_C2</bpmn:outgoing>\n    </bpmn:task>\n    <bpmn:task id=\"Task_Compile\" name=\"Compile asset, warranty and maintenance data\">\n      <bpmn:incoming>Flow_C2</bpmn:incoming>\n      <bpmn:outgoing>Flow_C3</bpmn:outgoing>\n      <bpmn:dataOutputAssociation id=\"Assoc_C1\"><bpmn:targetRef>DataObject_HandoverPackage</bpmn:targetRef></bpmn:dataOutputAssociation>\n    </bpmn:task>\n    <bpmn:dataObject id=\"DataObject_HandoverPackage_obj\"/>\n    <bpmn:dataObjectReference id=\"DataObject_HandoverPackage\" name=\"MEP asset handover package\" dataObjectRef=\"DataObject_HandoverPackage_obj\"/>\n    <bpmn:endEvent id=\"End_Contractor\" name=\"Package delivered\">\n      <bpmn:incoming>Flow_C3</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:sequenceFlow id=\"Flow_C1\" sourceRef=\"Start_MEPH\" targetRef=\"Task_Commission\"/>\n    <bpmn:sequenceFlow id=\"Flow_C2\" sourceRef=\"Task_Commission\" targetRef=\"Task_Compile\"/>\n    <bpmn:sequenceFlow id=\"Flow_C3\" sourceRef=\"Task_Compile\" targetRef=\"End_Contractor\"/>\n  </bpmn:process>\n  <bpmn:process id=\"Process_Owner\" isExecutable=\"false\">\n    <bpmn:laneSet id=\"LS_Process_Owner\">\n      <bpmn:lane id=\"Lane_CMMSAdmin\" name=\"CMMS administrator\">\n        <bpmn:flowNodeRef>Start_Owner</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>Task_CheckPackage</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>Task_LoadCMMS</bpmn:flowNodeRef>\n        <bpmn:flowNodeRef>End_Owner</bpmn:flowNodeRef>\n      </bpmn:lane>\n    </bpmn:laneSet>\n    <bpmn:startEvent id=\"Start_Owner\" name=\"Package received\">\n      <bpmn:outgoing>Flow_O1</bpmn:outgoing>\n    </bpmn:startEvent>\n    <bpmn:task id=\"Task_CheckPackage\" name=\"Check package against business rules\">\n      <bpmn:incoming>Flow_O1</bpmn:incoming>\n      <bpmn:outgoing>Flow_O2</bpmn:outgoing>\n    </bpmn:task>\n    <bpmn:task id=\"Task_LoadCMMS\" name=\"Load assets into CMMS\">\n      <bpmn:incoming>Flow_O2</bpmn:incoming>\n      <bpmn:outgoing>Flow_O3</bpmn:outgoing>\n    </bpmn:task>\n    <bpmn:endEvent id=\"End_Owner\" name=\"Assets in operation\">\n      <bpmn:incoming>Flow_O3</bpmn:incoming>\n    </bpmn:endEvent>\n    <bpmn:sequenceFlow id=\"Flow_O1\" sourceRef=\"Start_Owner\" targetRef=\"Task_CheckPackage\"/>\n    <bpmn:sequenceFlow id=\"Flow_O2\" sourceRef=\"Task_CheckPackage\" targetRef=\"Task_LoadCMMS\"/>\n    <bpmn:sequenceFlow id=\"Flow_O3\" sourceRef=\"Task_LoadCMMS\" targetRef=\"End_Owner\"/>\n  </bpmn:process>\n  <bpmndi:BPMNDiagram id=\"BPMNDiagram_1\"><bpmndi:BPMNPlane id=\"BPMNPlane_1\" bpmnElement=\"Collaboration_MEPH\">\n    <bpmndi:BPMNShape id=\"Participant_Contractor_di\" bpmnElement=\"Participant_Contractor\" isHorizontal=\"true\"><dc:Bounds x=\"0\" y=\"0\" width=\"900\" height=\"300\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Lane_Commissioning_di\" bpmnElement=\"Lane_Commissioning\" isHorizontal=\"true\"><dc:Bounds x=\"30\" y=\"0\" width=\"870\" height=\"150\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Lane_InfoManager_di\" bpmnElement=\"Lane_InfoManager\" isHorizontal=\"true\"><dc:Bounds x=\"30\" y=\"150\" width=\"870\" height=\"150\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Start_MEPH_di\" bpmnElement=\"Start_MEPH\"><dc:Bounds x=\"82\" y=\"57\" width=\"36\" height=\"36\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Task_Commission_di\" bpmnElement=\"Task_Commission\"><dc:Bounds x=\"175\" y=\"40\" width=\"110\" height=\"70\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Task_Compile_di\" bpmnElement=\"Task_Compile\"><dc:Bounds x=\"345\" y=\"190\" width=\"110\" height=\"70\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"DataObject_HandoverPackage_di\" bpmnElement=\"DataObject_HandoverPackage\"><dc:Bounds x=\"542\" y=\"200\" width=\"36\" height=\"50\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"End_Contractor_di\" bpmnElement=\"End_Contractor\"><dc:Bounds x=\"682\" y=\"207\" width=\"36\" height=\"36\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNEdge id=\"Flow_C1_di\" bpmnElement=\"Flow_C1\"><di:waypoint x=\"118\" y=\"75\"/><di:waypoint x=\"175\" y=\"75\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNEdge id=\"Flow_C2_di\" bpmnElement=\"Flow_C2\"><di:waypoint x=\"285\" y=\"75\"/><di:waypoint x=\"315\" y=\"75\"/><di:waypoint x=\"315\" y=\"225\"/><di:waypoint x=\"345\" y=\"225\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNEdge id=\"Flow_C3_di\" bpmnElement=\"Flow_C3\"><di:waypoint x=\"455\" y=\"225\"/><di:waypoint x=\"682\" y=\"225\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNShape id=\"Participant_Owner_di\" bpmnElement=\"Participant_Owner\" isHorizontal=\"true\"><dc:Bounds x=\"0\" y=\"330\" width=\"900\" height=\"150\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Lane_CMMSAdmin_di\" bpmnElement=\"Lane_CMMSAdmin\" isHorizontal=\"true\"><dc:Bounds x=\"30\" y=\"330\" width=\"870\" height=\"150\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Start_Owner_di\" bpmnElement=\"Start_Owner\"><dc:Bounds x=\"282\" y=\"387\" width=\"36\" height=\"36\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Task_CheckPackage_di\" bpmnElement=\"Task_CheckPackage\"><dc:Bounds x=\"375\" y=\"370\" width=\"110\" height=\"70\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"Task_LoadCMMS_di\" bpmnElement=\"Task_LoadCMMS\"><dc:Bounds x=\"545\" y=\"370\" width=\"110\" height=\"70\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNShape id=\"End_Owner_di\" bpmnElement=\"End_Owner\"><dc:Bounds x=\"742\" y=\"387\" width=\"36\" height=\"36\"/></bpmndi:BPMNShape>\n    <bpmndi:BPMNEdge id=\"Flow_O1_di\" bpmnElement=\"Flow_O1\"><di:waypoint x=\"318\" y=\"405\"/><di:waypoint x=\"375\" y=\"405\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNEdge id=\"Flow_O2_di\" bpmnElement=\"Flow_O2\"><di:waypoint x=\"485\" y=\"405\"/><di:waypoint x=\"545\" y=\"405\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNEdge id=\"Flow_O3_di\" bpmnElement=\"Flow_O3\"><di:waypoint x=\"655\" y=\"405\"/><di:waypoint x=\"742\" y=\"405\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNEdge id=\"Assoc_C1_di\" bpmnElement=\"Assoc_C1\"><di:waypoint x=\"400\" y=\"260\"/><di:waypoint x=\"560\" y=\"200\"/></bpmndi:BPMNEdge>\n    <bpmndi:BPMNEdge id=\"MessageFlow_Package_di\" bpmnElement=\"MessageFlow_Package\"><di:waypoint x=\"400\" y=\"260\"/><di:waypoint x=\"400\" y=\"323.5\"/><di:waypoint x=\"300\" y=\"323.5\"/><di:waypoint x=\"300\" y=\"387\"/></bpmndi:BPMNEdge>\n  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>\n</bpmn:definitions>",
